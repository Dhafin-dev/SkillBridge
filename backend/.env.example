# SkillBridge Backend Environment Configuration Template
NODE_ENV="development"
PORT="5000"

# MySQL Database Connection String (Prisma)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@127.0.0.1:3306/skillbridge"

# JWT Authentication
JWT_SECRET="skillbridge_super_secret_jwt_key_at_least_32_characters_long"
JWT_EXPIRES_IN="7d"

# Allowed CORS Origins (comma-separated for multiple origins)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

