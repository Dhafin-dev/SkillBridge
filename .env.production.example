# =================================================================
#  SKILLBRIDGE HUB — PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# =================================================================

APP_NAME="SkillBridge Hub"
APP_ENV=production
APP_KEY=base64:n78meZ1TygS5UMMrnnN0F6KN8J0/NxPr4P3vwy9oD4g=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://skillbridge.yourdomain.com

# -----------------------------------------------------------------
# 1. KONEKSI BASIS DATA CLOUD (SUPABASE POSTGRESQL)
# -----------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your_supabase_project_ref
DB_PASSWORD=your_supabase_database_password
DB_SSLMODE=require

# -----------------------------------------------------------------
# 2. ENDPOINT LAYANAN MIKRO NLP SKILLMATCH (VERCEL SERVERLESS CLOUD)
# -----------------------------------------------------------------
FASTAPI_MATCH_URL=https://skill-bridge-bice-kappa.vercel.app

# -----------------------------------------------------------------
# 3. KREDENSIAL SUPABASE STORAGE (BUCKET: resumes)
# -----------------------------------------------------------------
SUPABASE_URL=https://your_supabase_project_ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
SUPABASE_STORAGE_BUCKET=resumes

# -----------------------------------------------------------------
# 4. DRIVER SESI & CACHE
# -----------------------------------------------------------------
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_LEVEL=error
