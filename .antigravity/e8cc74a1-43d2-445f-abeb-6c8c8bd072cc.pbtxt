    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Search, Mic, Filter, History, TrendingUp, Campaign, User, Star, Code, ArrowRight, X } from \'lucide-react\';\nimport { ScreenView, Project } from \'../types\';\n\ninterface GlobalSearchProps {\n  onNavigate: (screen: ScreenView) => void;\n  onSelectProject?: (project: Project) => void;\n}\n\nexport const GlobalSearch: React.FC<GlobalSearchProps> = ({ onNavigate, onSelectProject }) => {\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [activeFilter, setActiveFilter] = useState<\'all\' | \'students\' | \'projects\'>(\'all\');\n  const [recentSearches, setRecentSearches] = useState([\n    \'Digital Marketing Strategy\',\n    \'UI/UX Design for E-commerce\',\n    \'React Developers\'\n  ]);\n\n  const trendingSkills = [\'Data Analysis\', \'Brand Identity\', \'SEO Optimization\', \'Machine Learning\', \'Video Editing\'];\n\n  const clearRecentSearches = () => {\n    setRecentSearches([]);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#f8f9ff] text-slate-900 pb-20 pt-6 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto\">\n      {/* Search Hero Section */}\n      <section className=\"max-w-3xl mx-auto mb-10 text-center\">\n        <h1 className=\"text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-2\">\n          What are you looking for?\n        </h1>\n        <p className=\"text-sm text-slate-500 mb-6\">Discover top academic talent and innovative UMKM projects.</p>\n\n        {/* Active Search Input */}\n        <div className=\"relative group max-w-2xl mx-auto\">\n          <div className=\"absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none\">\n            <Search className=\"w-5 h-5 text-slate-400 group-focus-within:text-blue-600 transition-colors\" />\n          </div>\n          <input\n            type=\"text\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            placeholder=\"Search skills, projects, or users...\"\n            className=\"w-full bg-white border border-slate-200/90 rounded-2xl py-3.5 pl-12 pr-12 text-sm font-medium text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-4 focus:ring-blue-100 focus:border-blue-600 transition-all shadow-xs hover:shadow-sm\"\n          />\n          <button\n            type=\"button\"\n            className=\"absolute inset-y-0 right-0 pr-4 flex items-center text-slate-400 hover:text-slate-600 transition-colors\"\n          >\n            <Mic className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Quick Filters */}\n        <div className=\"flex flex-wrap gap-2 mt-4 justify-center\">\n          <button\n            onClick={() => setActiveFilter(\'all\')}\n            className={`px-3.5 py-1.5 rounded-full text-xs font-semibold flex items-center gap-1.5 transition-colors border ${\n              activeFilter === \'all\'\n                ? \'bg-blue-600 text-white border-blue-600\'\n                : \'bg-white text-slate-600 border-slate-200 hover:bg-slate-50\'\n            }`}\n          >\n            <Filter className=\"w-3.5 h-3.5\" /> All Categories\n          </button>\n          <button\n            onClick={() => setActiveFilter(\'students\')}\n            className={`px-3.5 py-1.5 rounded-full text-xs font-semibold transition-colors border ${\n              activeFilter === \'students\'\n                ? \'bg-blue-600 text-white border-blue-600\'\n                : \'bg-white text-slate-600 border-slate-200 hover:bg-slate-50\'\n            }`}\n          >\n            Students\n          </button>\n          <button\n            onClick={() => setActiveFilter(\'projects\')}\n            className={`px-3.5 py-1.5 rounded-full text-xs font-semibold transition-colors border ${\n              activeFilter === \'projects\'\n                ? \'bg-blue-600 text-white border-blue-600\'\n                : \'bg-white text-slate-600 border-slate-200 hover:bg-slate-50\'\n            }`}\n          >\n            UMKM Projects\n          </button>\n        </div>\n      </section>\n\n      {/* Search Content Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-12 gap-6 max-w-5xl mx-auto\">\n        {/* Left Column: Recent & Trending */}\n        <div className=\"md:col-span-4 space-y-6\">\n          {/* Recent Searches */}\n          <div className=\"bg-white rounded-2xl p-5 shadow-xs border border-slate-200/80\">\n            <div className=\"flex items-center justify-between mb-3\">\n              <h2 className=\"text-xs font-bold text-slate-900 uppercase tracking-wider\">Recent Searches</h2>\n              {recentSearches.length > 0 && (\n                <button\n                  onClick={clearRecentSearches}\n                  className=\"text-xs font-bold text-blue-600 hover:underline\"\n                >\n                  Clear\n                </button>\n              )}\n            </div>\n            {recentSearches.length === 0 ? (\n              <p className=\"text-xs text-slate-400 py-2\">No recent searches.</p>\n            ) : (\n              <ul className=\"space-y-1\">\n                {recentSearches.map((item, i) => (\n                  <li key={i}>\n                    <button\n                      onClick={() => setSearchTerm(item)}\n                      className=\"w-full flex items-center gap-2.5 p-2 rounded-xl hover:bg-slate-50 transition-colors text-xs text-slate-700 text-left font-medium\"\n                    >\n                      <History className=\"w-4 h-4 text-slate-400 shrink-0\" />\n                      <span className=\"truncate\">{item}</span>\n                    </button>\n                  </li>\n                ))}\n              </ul>\n            )}\n          </div>\n\n          {/* Trending Skills */}\n          <div className=\"bg-white rounded-2xl p-5 shadow-xs border border-slate-200/80\">\n            <h2 className=\"text-xs font-bold text-slate-900 uppercase tracking-wider mb-3 flex items-center gap-1.5\">\n              <TrendingUp className=\"w-4 h-4 text-amber-500\" />\n              <span>Trending Skills</span>\n            </h2>\n            <div className=\"flex flex-wrap gap-1.5\">\n              {trendingSkills.map((skill) => (\n                <button\n                  key={skill}\n                  onClick={() => setSearchTerm(skill)}\n                  className=\"px-2.5 py-1 rounded-lg bg-slate-50 hover:bg-blue-50 text-xs font-medium text-slate-700 hover:text-blue-700 border border-slate-200/60 transition-colors\"\n                >\n                  {skill}\n                </button>\n              ))}\n            </div>\n          </div>\n        </div>\n\n        {/* Right Column: Suggestions Bento Grid */}\n        <div className=\"md:col-span-8 space-y-4\">\n          <h2 className=\"text-base font-bold text-slate-900 mb-2\">Suggested for you</h2>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            {/* Card 1: Project */}\n            <div\n              onClick={() => onNavigate(\'market\')}\n              className=\"bg-white rounded-2xl p-5 shadow-xs border border-slate-200/80 hover:shadow-md transition-all group cursor-pointer relative overflow-hidden flex flex-col justify-between\"\n            >\n              <div>\n                <div className=\"flex justify-between items-start mb-3\">\n                  <div className=\"w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center text-blue-600\">\n                    <Campaign className=\"w-5 h-5\" />\n                  </div>\n                  <span className=\"px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-[10px] font-bold uppercase tracking-wider\">\n                    Project\n                  </span>\n                </div>\n                <h3 className=\"text-sm font-bold text-slate-900 mb-1 group-hover:text-blue-600 transition-colors\">\n                  Marketing Campaign for Local Cafe\n                </h3>\n                <p className=\"text-xs text-slate-500 line-clamp-2 mb-4\">\n                  Looking for creative students to design a high-converting social media campaign to boost local foot traffic.\n                </p>\n              </div>\n\n              <div className=\"flex items-center gap-2 pt-2 border-t border-slate-100\">\n                <img\n                  src=\"https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=120&auto=format&fit=crop&q=80\"\n                  alt=\"Kopi Kita\"\n                  className=\"w-6 h-6 rounded-md object-cover\"\n                />\n                <span className=\"text-xs font-medium text-slate-700\">Kopi Kita UMKM</span>\n              </div>\n            </div>\n\n            {/* Card 2: Student */}\n            <div\n              onClick={() => onNavigate(\'students\')}\n              className=\"bg-white rounded-2xl p-5 shadow-xs border border-slate-200/80 hover:shadow-md transition-all group cursor-pointer relative overflow-hidden flex flex-col justify-between\"\n            >\n              <div>\n                <div className=\"flex justify-between items-start mb-3\">\n                  <img\n                    src=\"https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80\"\n                    alt=\"Sarah Jenkins\"\n                    className=\"w-10 h-10 rounded-full object-cover ring-2 ring-blue-500/20\"\n                  />\n                  <span className=\"px-2 py-0.5 rounded bg-blue-100 text-blue-800 text-[10px] font-bold uppercase tracking-wider\">\n                    Student\n                  </span>\n                </div>\n                <h3 className=\"text-sm font-bold text-slate-900 mb-1 group-hover:text-blue-600 transition-colors\">\n                  Sarah Jenkins\n                </h3>\n                <p className=\"text-xs text-slate-500 mb-2\">Graphic Design & Branding</p>\n                <div className=\"flex flex-wrap gap-1 mb-3\">\n                  <span className=\"text-[10px] font-semibold bg-slate-100 px-2 py-0.5 rounded text-slate-600\">Illustrator</span>\n                  <span className=\"text-[10px] font-semibold bg-slate-100 px-2 py-0.5 rounded text-slate-600\">Figma</span>\n                </div>\n              </div>\n\n              <div className=\"flex items-center gap-1.5 pt-2 border-t border-slate-100\">\n                <Star className=\"w-3.5 h-3.5 text-amber-500 fill-amber-500\" />\n                <span className=\"text-xs font-bold text-slate-900\">4.9</span>\n                <span className=\"text-[11px] text-slate-500\">(12 completed projects)</span>\n              </div>\n            </div>\n\n            {/* Card 3: Full Width Category */}\n            <div\n              onClick={() => onNavigate(\'market\')}\n              className=\"sm:col-span-2 bg-white rounded-2xl p-5 shadow-xs border border-slate-200/80 hover:shadow-md transition-all group cursor-pointer flex flex-col sm:flex-row gap-4 items-center\"\n            >\n              <div className=\"w-full sm:w-1/3 h-32 rounded-xl overflow-hidden relative shrink-0\">\n                <img\n                  src=\"https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=400&auto=format&fit=crop&q=80\"\n                  alt=\"Web Development\"\n                  className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\"\n                />\n                <span className=\"absolute bottom-2 left-2 px-2 py-0.5 rounded bg-amber-500 text-white text-[10px] font-bold uppercase tracking-wider\">\n                  Category\n                </span>\n              </div>\n\n              <div className=\"w-full sm:w-2/3 flex flex-col justify-between h-full\">\n                <div>\n                  <h3 className=\"text-base font-bold text-slate-900 mb-1 group-hover:text-blue-600 transition-colors\">\n                    Web Development & IT\n                  </h3>\n                  <p className=\"text-xs text-slate-500 mb-3\">\n                    Find tech-savvy students ready to build e-commerce sites, landing pages, and custom software solutions for your business.\n                  </p>\n                </div>\n\n                <div className=\"flex items-center justify-between pt-2 border-t border-slate-100\">\n                  <div className=\"flex items-center gap-2\">\n                    <div className=\"flex -space-x-1.5\">\n                      <img\n                        src=\"https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=100&auto=format&fit=crop&q=80\"\n                        className=\"w-5 h-5 rounded-full ring-2 ring-white object-cover\"\n                      />\n                      <img\n                        src=\"https://images.unsplash.com/photo-1517841905240-472988babdf9?w=100&auto=format&fit=crop&q=80\"\n                        className=\"w-5 h-5 rounded-full ring-2 ring-white object-cover\"\n                      />\n                    </div>\n                    <span className=\"text-xs font-semibold text-slate-700\">+50 Active Students</span>\n                  </div>\n                  <ArrowRight className=\"w-4 h-4 text-blue-600 group-hover:translate-x-1 transition-transform\" />\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
