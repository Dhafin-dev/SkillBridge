    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Download, TrendingUp, Users, Rocket, MoreVertical, Award, ArrowLeft } from \'lucide-react\';\nimport { ScreenView } from \'../../types\';\n\ninterface ReportsAnalyticsProps {\n  onNavigate: (screen: ScreenView) => void;\n}\n\nexport const ReportsAnalytics: React.FC<ReportsAnalyticsProps> = ({ onNavigate }) => {\n  const [timeRange, setTimeRange] = useState<\'7D\' | \'30D\' | \'YTD\' | \'ALL\'>(\'30D\');\n\n  return (\n    <div className=\"min-h-screen bg-[#f8f9ff] text-slate-900 pb-24 pt-4 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto\">\n      {/* Top Admin Sub-Nav */}\n      <div className=\"flex flex-wrap items-center gap-2 mb-6 bg-white p-2 rounded-2xl border border-slate-200/80 shadow-xs text-xs font-semibold overflow-x-auto\">\n        <button onClick={() => onNavigate(\'admin-overview\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Overview</button>\n        <button onClick={() => onNavigate(\'matching-management\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Matching AI</button>\n        <button onClick={() => onNavigate(\'admin-projects\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Projects</button>\n        <button onClick={() => onNavigate(\'user-management\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Users</button>\n        <button onClick={() => onNavigate(\'category-management\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Categories</button>\n        <button onClick={() => onNavigate(\'reports-analytics\')} className=\"px-3.5 py-2 rounded-xl bg-blue-600 text-white shadow-xs\">Analytics</button>\n        <button onClick={() => onNavigate(\'verification-center\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Verifications</button>\n        <button onClick={() => onNavigate(\'platform-settings\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Settings</button>\n      </div>\n\n      {/* Header & Filter Controls */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4\">\n        <div>\n          <h1 className=\"text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight\">Reports & Analytics</h1>\n          <p className=\"text-xs sm:text-sm text-slate-500 mt-1\">Platform performance, matching velocity, and user growth metrics.</p>\n        </div>\n\n        <div className=\"flex items-center gap-3 w-full sm:w-auto\">\n          <div className=\"bg-white border border-slate-200 rounded-2xl p-1 flex shadow-xs text-xs font-semibold\">\n            {([\'7D\', \'30D\', \'YTD\', \'ALL\'] as const).map(range => (\n              <button\n                key={range}\n                onClick={() => setTimeRange(range)}\n                className={`px-3 py-1.5 rounded-xl transition-colors ${\n                  timeRange === range ? \'bg-blue-600 text-white\' : \'text-slate-600 hover:bg-slate-50\'\n                }`}\n              >\n                {range}\n              </button>\n            ))}\n          </div>\n\n          <button\n            onClick={() => alert(\'Analytics export downloaded (CSV / PDF)\')}\n            className=\"bg-white border border-slate-200 text-slate-800 font-semibold text-xs px-4 py-2.5 rounded-2xl hover:bg-slate-50 transition-colors shadow-xs flex items-center gap-2 h-10\"\n          >\n            <Download className=\"w-4 h-4\" />\n            <span>Export Report</span>\n          </button>\n        </div>\n      </div>\n\n      {/* KPI Cards */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8\">\n        {/* Card 1 */}\n        <div className=\"bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs relative overflow-hidden\">\n          <div className=\"flex justify-between items-start mb-2\">\n            <span className=\"text-[11px] font-bold text-slate-400 uppercase tracking-wider\">\n              Monthly Projects\n            </span>\n            <div className=\"p-2 rounded-xl bg-blue-50 text-blue-600\">\n              <Rocket className=\"w-5 h-5\" />\n            </div>\n          </div>\n          <div className=\"flex items-baseline gap-2\">\n            <span className=\"text-3xl font-black text-slate-900\">3,245</span>\n            <span className=\"text-xs font-bold text-emerald-600 flex items-center gap-0.5\">\n              <TrendingUp className=\"w-3.5 h-3.5\" /> +12.5%\n            </span>\n          </div>\n          <div className=\"mt-4 h-1.5 w-full bg-slate-100 rounded-full overflow-hidden\">\n            <div className=\"h-full bg-blue-600 rounded-full w-[65%]\" />\n          </div>\n        </div>\n\n        {/* Card 2 */}\n        <div className=\"bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs relative overflow-hidden\">\n          <div className=\"flex justify-between items-start mb-2\">\n            <span className=\"text-[11px] font-bold text-slate-400 uppercase tracking-wider\">\n              New User Onboarding\n            </span>\n            <div className=\"p-2 rounded-xl bg-indigo-50 text-indigo-600\">\n              <Users className=\"w-5 h-5\" />\n            </div>\n          </div>\n          <div className=\"flex items-baseline gap-2\">\n            <span className=\"text-3xl font-black text-slate-900\">1,890</span>\n            <span className=\"text-xs font-bold text-emerald-600 flex items-center gap-0.5\">\n              <TrendingUp className=\"w-3.5 h-3.5\" /> +8.2%\n            </span>\n          </div>\n          <div className=\"mt-4 h-1.5 w-full bg-slate-100 rounded-full overflow-hidden\">\n            <div className=\"h-full bg-indigo-600 rounded-full w-[45%]\" />\n          </div>\n        </div>\n\n        {/* Card 3 */}\n        <div className=\"bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs relative overflow-hidden\">\n          <div className=\"flex justify-between items-start mb-2\">\n            <span className=\"text-[11px] font-bold text-slate-400 uppercase tracking-wider\">\n              Active Platform Pool\n            </span>\n            <div className=\"p-2 rounded-xl bg-emerald-50 text-emerald-600\">\n              <Award className=\"w-5 h-5\" />\n            </div>\n          </div>\n          <div className=\"flex items-baseline gap-2\">\n            <span className=\"text-3xl font-black text-slate-900\">45.2k</span>\n            <span className=\"text-xs font-bold text-slate-500\">Total Active</span>\n          </div>\n          <div className=\"mt-4 h-1.5 w-full bg-slate-100 rounded-full overflow-hidden\">\n            <div className=\"h-full bg-emerald-600 rounded-full w-[80%]\" />\n          </div>\n        </div>\n      </div>\n\n      {/* Visual Analytics Bento Section */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* User Growth Trend */}\n        <div className=\"lg:col-span-2 bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs flex flex-col justify-between min-h-[360px]\">\n          <div className=\"flex justify-between items-center mb-6\">\n            <h2 className=\"text-base font-bold text-slate-900\">User Onboarding Growth</h2>\n            <button className=\"p-1 text-slate-400 hover:text-slate-700\">\n              <MoreVertical className=\"w-5 h-5\" />\n            </button>\n          </div>\n\n          <div className=\"flex-1 bg-slate-50 rounded-2xl p-4 flex items-end relative overflow-hidden border border-slate-100\">\n            <svg className=\"w-full h-44\" viewBox=\"0 0 100 40\" preserveAspectRatio=\"none\">\n              <defs>\n                <linearGradient id=\"grad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                  <stop offset=\"0%\" stopColor=\"#2563eb\" stopOpacity=\"0.4\" />\n                  <stop offset=\"100%\" stopColor=\"#2563eb\" stopOpacity=\"0\" />\n                </linearGradient>\n              </defs>\n              <path d=\"M0,40 L0,30 C10,25 20,35 30,20 C40,5 50,25 60,15 C70,5 80,10 90,5 L100,2 L100,40 Z\" fill=\"url(#grad)\" />\n              <path d=\"M0,30 C10,25 20,35 30,20 C40,5 50,25 60,15 C70,5 80,10 90,5 L100,2\" fill=\"none\" stroke=\"#2563eb\" strokeWidth=\"1.5\" />\n            </svg>\n          </div>\n        </div>\n\n        {/* Categories Pie Chart Simulation */}\n        <div className=\"bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs flex flex-col justify-between min-h-[360px]\">\n          <div className=\"flex justify-between items-center mb-4\">\n            <h2 className=\"text-base font-bold text-slate-900\">Project Disciplines</h2>\n          </div>\n\n          <div className=\"flex flex-col items-center justify-center my-auto space-y-4\">\n            <div className=\"w-36 h-36 rounded-full border-[10px] border-blue-600 border-t-indigo-600 border-r-emerald-500 border-b-amber-500 flex items-center justify-center\">\n              <div className=\"text-center\">\n                <span className=\"text-2xl font-black text-slate-900 block leading-none\">1.2k</span>\n                <span className=\"text-[10px] font-bold text-slate-400 uppercase\">Total</span>\n              </div>\n            </div>\n\n            <div className=\"w-full space-y-2 text-xs font-semibold text-slate-700\">\n              <div className=\"flex justify-between items-center\">\n                <span className=\"flex items-center gap-1.5\"><span className=\"w-2.5 h-2.5 rounded-full bg-blue-600\" /> Tech & IT</span>\n                <span>35%</span>\n              </div>\n              <div className=\"flex justify-between items-center\">\n                <span className=\"flex items-center gap-1.5\"><span className=\"w-2.5 h-2.5 rounded-full bg-amber-500\" /> Marketing</span>\n                <span>25%</span>\n              </div>\n              <div className=\"flex justify-between items-center\">\n                <span className=\"flex items-center gap-1.5\"><span className=\"w-2.5 h-2.5 rounded-full bg-emerald-500\" /> Design</span>\n                <span>25%</span>\n              </div>\n              <div className=\"flex justify-between items-center\">\n                <span className=\"flex items-center gap-1.5\"><span className=\"w-2.5 h-2.5 rounded-full bg-indigo-600\" /> Other</span>\n                <span>15%</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
