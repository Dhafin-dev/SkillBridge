  file_change {
    absolute_path_uri: "file:///src/components/Messages/ChatList.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Search, Pin, MessageSquare, Plus, Store, Users, ArrowLeft } from \'lucide-react\';\nimport { ScreenView } from \'../../types\';\n\ninterface ChatListProps {\n  onNavigate: (screen: ScreenView) => void;\n}\n\nexport const ChatList: React.FC<ChatListProps> = ({ onNavigate }) => {\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [activeTab, setActiveTab] = useState<\'All\' | \'Projects\' | \'UMKM\' | \'Students\'>(\'All\');\n\n  return (\n    <div className=\"min-h-screen bg-[#f8f9ff] text-slate-900 pb-24 max-w-3xl mx-auto\">\n      {/* Top Header */}\n      <header className=\"sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200/80 px-4 py-3 flex items-center justify-between shadow-xs\">\n        <h1 className=\"text-xl font-extrabold text-blue-600\">Messages</h1>\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={() => onNavigate(\'public-student-profile\')}\n            className=\"w-8 h-8 rounded-full overflow-hidden border border-slate-200\"\n          >\n            <img\n              src=\"https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80\"\n              alt=\"Avatar\"\n              className=\"w-full h-full object-cover\"\n            />\n          </button>\n        </div>\n      </header>\n\n      <main className=\"px-4 py-4 space-y-5\">\n        {/* Search & Tabs */}\n        <div className=\"space-y-3\">\n          <div className=\"relative\">\n            <Search className=\"w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400\" />\n            <input\n              type=\"text\"\n              value={searchTerm}\n              onChange={(e) => setSearchTerm(e.target.value)}\n              placeholder=\"Search by project or user...\"\n              className=\"w-full h-11 pl-10 pr-4 bg-white border border-slate-200 rounded-2xl text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-600 shadow-xs\"\n            />\n          </div>\n\n          <div className=\"flex overflow-x-auto gap-2 pb-1 text-xs font-semibold\">\n            {([\'All\', \'Projects\', \'UMKM\', \'Students\'] as const).map(tab => (\n              <button\n                key={tab}\n                onClick={() => setActiveTab(tab)}\n                className={`px-4 py-1.5 rounded-full whitespace-nowrap transition-colors ${\n                  activeTab === tab\n                    ? \'bg-blue-600 text-white shadow-xs\'\n                    : \'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50\'\n                }`}\n              >\n                {tab}\n              </button>\n            ))}\n          </div>\n        </div>\n\n        {/* Pinned Section */}\n        <div className=\"space-y-2\">\n          <h2 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider flex items-center gap-1\">\n            <Pin className=\"w-3.5 h-3.5 text-blue-600\" />\n            <span>Pinned</span>\n          </h2>\n\n          <div className=\"flex overflow-x-auto gap-3 pb-2 -mx-4 px-4\">\n            {/* Pinned 1 */}\n            <div\n              onClick={() => onNavigate(\'chat-detail\')}\n              className=\"min-w-[220px] bg-white rounded-2xl p-4 shadow-xs border border-slate-200/80 cursor-pointer hover:shadow-md transition-all flex flex-col justify-between\"\n            >\n              <div className=\"flex justify-between items-start mb-2\">\n                <div className=\"flex gap-2.5 items-center\">\n                  <img\n                    src=\"https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=150&auto=format&fit=crop&q=80\"\n                    alt=\"Sarah Chen\"\n                    className=\"w-10 h-10 rounded-full object-cover shrink-0\"\n                  />\n                  <div>\n                    <h3 className=\"text-xs font-bold text-slate-900 truncate\">Sarah Chen</h3>\n                    <p className=\"text-[10px] text-blue-600 font-semibold truncate\">Social Media Revamp</p>\n                  </div>\n                </div>\n                <span className=\"text-[10px] text-slate-400\">10:42 AM</span>\n              </div>\n              <p className=\"text-xs text-slate-600 line-clamp-2\">\n                I\'ve reviewed the latest wireframes. They look great! Let\'s proceed with high fidelity...\n              </p>\n            </div>\n\n            {/* Pinned 2 */}\n            <div\n              onClick={() => onNavigate(\'chat-detail\')}\n              className=\"min-w-[220px] bg-white rounded-2xl p-4 shadow-xs border border-slate-200/80 cursor-pointer hover:shadow-md transition-all flex flex-col justify-between\"\n            >\n              <div className=\"flex justify-between items-start mb-2\">\n                <div className=\"flex gap-2.5 items-center\">\n                  <div className=\"w-10 h-10 rounded-full bg-emerald-100 text-emerald-800 font-bold flex items-center justify-center shrink-0 text-xs\">\n                    KK\n                  </div>\n                  <div>\n                    <h3 className=\"text-xs font-bold text-slate-900 truncate\">Kopi Kenangan</h3>\n                    <p className=\"text-[10px] text-blue-600 font-semibold truncate\">Inventory System</p>\n                  </div>\n                </div>\n                <span className=\"text-[10px] text-slate-400\">Yesterday</span>\n              </div>\n              <div className=\"flex justify-between items-end\">\n                <p className=\"text-xs text-slate-600 font-medium line-clamp-2 flex-1 pr-2\">\n                  Can we schedule a quick call tomorrow to discuss API integration?\n                </p>\n                <span className=\"w-4 h-4 bg-red-600 text-white rounded-full flex items-center justify-center text-[10px] font-bold shrink-0\">\n                  2\n                </span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* All Conversations */}\n        <div className=\"space-y-2\">\n          <h2 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">Recent Conversations</h2>\n\n          <div className=\"space-y-2\">\n            <div\n              onClick={() => onNavigate(\'chat-detail\')}\n              className=\"bg-white rounded-2xl p-3.5 shadow-xs border border-slate-200/80 flex items-center gap-3 cursor-pointer hover:bg-slate-50/80 transition-colors\"\n            >\n              <img\n                src=\"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&auto=format&fit=crop&q=80\"\n                alt=\"David Kim\"\n                className=\"w-12 h-12 rounded-full object-cover shrink-0\"\n              />\n              <div className=\"flex-1 min-w-0\">\n                <div className=\"flex justify-between items-baseline mb-0.5\">\n                  <h3 className=\"text-xs font-bold text-slate-900 truncate\">David Kim</h3>\n                  <span className=\"text-[10px] text-slate-400\">Tue</span>\n                </div>\n                <p className=\"text-[11px] font-semibold text-blue-600 mb-0.5 truncate\">E-commerce Backend</p>\n                <p className=\"text-xs text-slate-500 truncate\">\n                  The pull request has been merged. I\'ll start on the next task.\n                </p>\n              </div>\n            </div>\n\n            <div\n              onClick={() => onNavigate(\'chat-detail\')}\n              className=\"bg-white rounded-2xl p-3.5 shadow-xs border border-slate-200/80 flex items-center gap-3 cursor-pointer hover:bg-slate-50/80 transition-colors\"\n            >\n              <img\n                src=\"https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80\"\n                alt=\"Bapak Budi\"\n                className=\"w-12 h-12 rounded-full object-cover shrink-0\"\n              />\n              <div className=\"flex-1 min-w-0\">\n                <div className=\"flex justify-between items-baseline mb-0.5\">\n                  <h3 className=\"text-xs font-bold text-slate-900 truncate\">Bapak Budi (Batik Nusantara)</h3>\n                  <span className=\"text-[10px] text-slate-400\">Oct 12</span>\n                </div>\n                <p className=\"text-[11px] font-semibold text-blue-600 mb-0.5 truncate\">Digital Marketing Campaign</p>\n                <p className=\"text-xs text-slate-500 truncate\">\n                  Terima kasih atas bantuannya. Laporannya sangat jelas.\n                </p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </main>\n\n      {/* Floating Action Button */}\n      <button\n        onClick={() => onNavigate(\'chat-detail\')}\n        className=\"fixed bottom-20 right-4 w-12 h-12 bg-blue-600 text-white rounded-2xl shadow-lg flex items-center justify-center hover:bg-blue-700 transition-all z-40\"\n      >\n        <Plus className=\"w-6 h-6\" />\n      </button>\n    </div>\n  );\n};\n"
    }
