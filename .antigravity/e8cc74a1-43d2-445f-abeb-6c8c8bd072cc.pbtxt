    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Home, Store, MessageSquare, User, LayoutDashboard, Briefcase, Users } from \'lucide-react\';\nimport { ScreenView, Role } from \'../types\';\n\ninterface BottomNavProps {\n  currentScreen: ScreenView;\n  currentUserRole: Role;\n  onNavigate: (screen: ScreenView) => void;\n  chatUnreadCount?: number;\n}\n\nexport const BottomNav: React.FC<BottomNavProps> = ({\n  currentScreen,\n  currentUserRole,\n  onNavigate,\n  chatUnreadCount = 1\n}) => {\n  // Determine active tab identifier based on screen\n  const getActiveTab = () => {\n    if (currentScreen === \'landing\' || currentScreen === \'student-dashboard\' || currentScreen === \'admin-overview\') return \'home\';\n    if (currentScreen === \'market\' || currentScreen === \'project-details\') return \'market\';\n    if (currentScreen === \'my-projects\' || currentScreen === \'my-requests\') return \'workspace\';\n    if (currentScreen === \'students\') return \'market\';\n    return \'home\';\n  };\n\n  const activeTab = getActiveTab();\n\n  return (\n    <div className=\"fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200/80 px-6 py-2 shadow-lg\">\n      <div className=\"max-w-md mx-auto flex items-center justify-between\">\n        {/* Home Tab */}\n        <button\n          onClick={() => {\n            if (currentUserRole === \'student\') onNavigate(\'student-dashboard\');\n            else if (currentUserRole === \'admin\') onNavigate(\'admin-overview\');\n            else onNavigate(\'landing\');\n          }}\n          className={`flex flex-col items-center gap-1 transition-all ${\n            activeTab === \'home\' ? \'text-emerald-700 font-bold\' : \'text-slate-500 hover:text-slate-900\'\n          }`}\n        >\n          <div className={`p-1.5 rounded-xl transition-all ${\n            activeTab === \'home\' ? \'bg-emerald-300/80 text-emerald-900 shadow-xs scale-105\' : \'\'\n          }`}>\n            <Home className=\"w-5 h-5\" />\n          </div>\n          <span className=\"text-[11px] font-medium tracking-tight\">Home</span>\n        </button>\n\n        {/* Market Tab */}\n        <button\n          onClick={() => onNavigate(\'market\')}\n          className={`flex flex-col items-center gap-1 transition-all ${\n            activeTab === \'market\' ? \'text-emerald-700 font-bold\' : \'text-slate-500 hover:text-slate-900\'\n          }`}\n        >\n          <div className={`p-1.5 rounded-xl transition-all ${\n            activeTab === \'market\' ? \'bg-emerald-300/80 text-emerald-900 shadow-xs scale-105\' : \'\'\n          }`}>\n            <Store className=\"w-5 h-5\" />\n          </div>\n          <span className=\"text-[11px] font-medium tracking-tight\">Market</span>\n        </button>\n\n        {/* Chat / Workspace Tab */}\n        <button\n          onClick={() => {\n            if (currentUserRole === \'student\') onNavigate(\'my-projects\');\n            else onNavigate(\'my-requests\');\n          }}\n          className={`flex flex-col items-center gap-1 transition-all relative ${\n            activeTab === \'workspace\' ? \'text-emerald-700 font-bold\' : \'text-slate-500 hover:text-slate-900\'\n          }`}\n        >\n          <div className={`p-1.5 rounded-xl transition-all relative ${\n            activeTab === \'workspace\' ? \'bg-emerald-300/80 text-emerald-900 shadow-xs scale-105\' : \'\'\n          }`}>\n            <MessageSquare className=\"w-5 h-5\" />\n            {chatUnreadCount > 0 && (\n              <span className=\"absolute -top-1 -right-1 w-2.5 h-2.5 bg-blue-600 border-2 border-white rounded-full\"></span>\n            )}\n          </div>\n          <span className=\"text-[11px] font-medium tracking-tight\">Chat</span>\n        </button>\n\n        {/* Profile / Stats Tab */}\n        <button\n          onClick={() => {\n            if (currentUserRole === \'admin\') onNavigate(\'admin-overview\');\n            else if (currentUserRole === \'umkm\') onNavigate(\'students\');\n            else onNavigate(\'student-dashboard\');\n          }}\n          className={`flex flex-col items-center gap-1 transition-all ${\n            currentScreen === \'student-dashboard\' || currentScreen === \'admin-overview\' || currentScreen === \'students\'\n              ? \'text-emerald-700 font-bold\'\n              : \'text-slate-500 hover:text-slate-900\'\n          }`}\n        >\n          <div className={`p-1.5 rounded-xl transition-all ${\n            currentScreen === \'student-dashboard\' || currentScreen === \'admin-overview\' || currentScreen === \'students\'\n              ? \'bg-emerald-300/80 text-emerald-900 shadow-xs scale-105\'\n              : \'\'\n          }`}>\n            <User className=\"w-5 h-5\" />\n          </div>\n          <span className=\"text-[11px] font-medium tracking-tight\">Profile</span>\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    }
