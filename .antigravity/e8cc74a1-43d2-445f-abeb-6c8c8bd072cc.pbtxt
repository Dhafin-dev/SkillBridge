  file_change {
    absolute_path_uri: "file:///src/components/ProjectDetails.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { ArrowLeft, MoreVertical, Calendar, Users, Layers, Zap, BookOpen, Target, CheckCircle, Bookmark, Navigation } from \'lucide-react\';\nimport { Project, ScreenView } from \'../types\';\n\ninterface ProjectDetailsProps {\n  project: Project;\n  onBack: () => void;\n  onApply: (project: Project) => void;\n  onSave?: (project: Project) => void;\n  onViewUmkmProfile?: (companyName: string) => void;\n}\n\nexport const ProjectDetails: React.FC<ProjectDetailsProps> = ({\n  project,\n  onBack,\n  onApply,\n  onSave,\n  onViewUmkmProfile\n}) => {\n  const [isSaved, setIsSaved] = useState(false);\n\n  return (\n    <div className=\"min-h-[calc(100vh-80px)] bg-[#f8f9ff] pb-28 pt-3 px-4 sm:px-6\">\n      <div className=\"max-w-3xl mx-auto space-y-4\">\n        \n        {/* Top Header Bar */}\n        <div className=\"flex items-center justify-between py-2\">\n          <button\n            onClick={onBack}\n            className=\"p-2 rounded-full bg-white hover:bg-slate-100 text-slate-700 transition-colors border border-slate-200 shadow-xs\"\n            aria-label=\"Go Back\"\n          >\n            <ArrowLeft className=\"w-5 h-5\" />\n          </button>\n          <h1 className=\"text-xl font-bold text-slate-900 tracking-tight\">\n            Project Details\n          </h1>\n          <button \n            className=\"p-2 rounded-full bg-white hover:bg-slate-100 text-slate-700 transition-colors border border-slate-200 shadow-xs\"\n            aria-label=\"Options\"\n          >\n            <MoreVertical className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Top Hero Card matching Screenshot 2 */}\n        <div className=\"bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs space-y-5 relative overflow-hidden\">\n          <div className=\"h-1.5 w-full bg-gradient-to-r from-blue-600 via-teal-400 to-emerald-400 absolute top-0 left-0 right-0\"></div>\n\n          <div className=\"flex items-start gap-4 pt-1\">\n            <img\n              src={project.companyLogo}\n              alt={project.companyName}\n              className=\"w-16 h-16 rounded-2xl object-cover border border-slate-200 shadow-xs flex-shrink-0\"\n            />\n            <div className=\"space-y-1\">\n              <h2 className=\"text-xl sm:text-2xl font-black text-slate-900 leading-snug\">\n                {project.title}\n              </h2>\n              <div className=\"flex items-center gap-1.5 text-sm font-semibold text-slate-600\">\n                <span className=\"w-4 h-4 rounded-sm bg-slate-100 flex items-center justify-center text-xs\">\360\237\217\242</span>\n                <span>{project.companyName}</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Skill Match Pill */}\n          <div className=\"inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-blue-100 text-blue-800 text-xs font-bold border border-blue-200 shadow-xs\">\n            <Zap className=\"w-4 h-4 text-blue-600 fill-current\" />\n            <span>{project.matchScore}% Skill Match</span>\n          </div>\n\n          {/* Quick Info Grid */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 border-t border-slate-100 text-xs font-medium text-slate-600\">\n            <div className=\"flex items-center gap-2\">\n              <Calendar className=\"w-4 h-4 text-slate-400\" />\n              <span>Deadline: <strong className=\"text-slate-800\">{project.deadline || \'Oct 24, 2024\'}</strong></span>\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <Users className=\"w-4 h-4 text-slate-400\" />\n              <span>Team Size: <strong className=\"text-slate-800\">{project.teamSize || \'2-3 Students\'}</strong></span>\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <Layers className=\"w-4 h-4 text-slate-400\" />\n              <span>Category: <strong className=\"text-slate-800\">{project.category}</strong></span>\n            </div>\n          </div>\n        </div>\n\n        {/* Project Overview Section */}\n        <div className=\"bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs space-y-3\">\n          <div className=\"flex items-center gap-2 text-slate-900 font-extrabold text-lg\">\n            <BookOpen className=\"w-5 h-5 text-blue-600\" />\n            <h3>Project Overview</h3>\n          </div>\n          <p className=\"text-sm text-slate-600 leading-relaxed font-normal\">\n            {project.overview || project.description}\n          </p>\n        </div>\n\n        {/* Project Objectives Section */}\n        <div className=\"bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs space-y-4\">\n          <div className=\"flex items-center gap-2 text-slate-900 font-extrabold text-lg\">\n            <Target className=\"w-5 h-5 text-blue-600\" />\n            <h3>Project Objectives</h3>\n          </div>\n          <ul className=\"space-y-3\">\n            {(project.objectives || [\n              \'Develop a cohesive, modern visual identity that appeals to Gen Z and Millennial coffee enthusiasts.\',\n              \'Create a comprehensive brand guideline document for future internal use.\',\n              \'Outline a 3-month digital launch strategy focusing on Instagram and TikTok.\'\n            ]).map((obj, i) => (\n              <li key={i} className=\"flex items-start gap-3 text-sm text-slate-700 font-medium\">\n                <span className=\"w-2.5 h-2.5 rounded-full bg-teal-400 mt-1.5 flex-shrink-0\"></span>\n                <span>{obj}</span>\n              </li>\n            ))}\n          </ul>\n        </div>\n\n        {/* Required Skills Section */}\n        <div className=\"bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs space-y-3\">\n          <h3 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">\n            Required Skills\n          </h3>\n          <div className=\"flex flex-wrap gap-2\">\n            {project.tags.map(skill => (\n              <span\n                key={skill}\n                className=\"px-4 py-2 rounded-xl bg-blue-50 text-blue-800 text-xs font-semibold border border-blue-100\"\n              >\n                {skill}\n              </span>\n            ))}\n          </div>\n        </div>\n\n        {/* Deliverables Section */}\n        <div className=\"bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs space-y-4\">\n          <h3 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">\n            Deliverables\n          </h3>\n          <ul className=\"space-y-2.5\">\n            {(project.deliverables || [\n              \'Vector Logo Files (SVG, EPS)\',\n              \'Brand Guideline PDF\',\n              \'3 Packaging Mockups\',\n              \'Digital Strategy Deck\'\n            ]).map((del, i) => (\n              <li key={i} className=\"flex items-center gap-2.5 text-sm text-slate-800 font-medium\">\n                <span className=\"w-2 h-2 rounded-full bg-blue-600\"></span>\n                <span>{del}</span>\n              </li>\n            ))}\n          </ul>\n        </div>\n\n        {/* About the UMKM Section */}\n        <div className=\"bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs space-y-3\">\n          <h3 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">\n            About the UMKM\n          </h3>\n          <p className=\"text-sm text-slate-600 leading-relaxed font-normal\">\n            {project.aboutUmkm || `${project.companyName} is a growing local enterprise focused on delivering premium consumer products and digital innovation.`}\n          </p>\n          <div className=\"pt-1\">\n            <button\n              onClick={() => onViewUmkmProfile?.(project.companyName)}\n              className=\"inline-flex items-center gap-1 text-sm font-bold text-blue-600 hover:text-blue-700\"\n            >\n              <span>View Profile</span>\n              <Navigation className=\"w-3.5 h-3.5 rotate-90\" />\n            </button>\n          </div>\n        </div>\n\n      </div>\n\n      {/* Fixed Sticky Action Bar matching Screenshot 2 */}\n      <div className=\"fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200 p-4 shadow-xl\">\n        <div className=\"max-w-3xl mx-auto flex items-center gap-3\">\n          <button\n            onClick={() => setIsSaved(!isSaved)}\n            className={`flex items-center justify-center gap-2 px-5 py-3.5 rounded-2xl border font-bold text-sm transition-all ${\n              isSaved \n                ? \'bg-blue-50 border-blue-300 text-blue-700\'\n                : \'bg-white border-slate-300 text-slate-700 hover:bg-slate-50\'\n            }`}\n          >\n            <Bookmark className={`w-4 h-4 ${isSaved ? \'fill-current\' : \'\'}`} />\n            <span>{isSaved ? \'Saved\' : \'Save Project\'}</span>\n          </button>\n\n          <button\n            onClick={() => onApply(project)}\n            className=\"flex-1 flex items-center justify-center gap-2 py-3.5 px-6 rounded-2xl bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-extrabold text-sm shadow-lg shadow-blue-600/25 transition-all\"\n          >\n            <span>Apply Now</span>\n            <span className=\"text-base font-normal\">\342\226\267</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
