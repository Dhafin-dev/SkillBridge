      replacement_content: "import React, { useState } from \'react\';\nimport { Mail, Lock, Eye, EyeOff, ArrowRight } from \'lucide-react\';\nimport { ScreenView } from \'../../types\';\n\ninterface LoginProps {\n  onLoginSuccess: (email: string) => void;\n  onNavigate: (screen: ScreenView) => void;\n}\n\nexport const Login: React.FC<LoginProps> = ({ onLoginSuccess, onNavigate }) => {\n  const [email, setEmail] = useState(\'alex.rivers@university.edu\');\n  const [password, setPassword] = useState(\'\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\');\n  const [showPassword, setShowPassword] = useState(false);\n  const [rememberMe, setRememberMe] = useState(true);\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    onLoginSuccess(email);\n  };\n\n  return (\n    <div className=\"min-h-[calc(100vh-80px)] bg-gradient-to-b from-blue-50/50 via-white to-blue-50/30 py-8 px-4 flex items-center justify-center\">\n      <div className=\"w-full max-w-md bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-xl space-y-6\">\n        \n        {/* Top Logo Container matching Screenshot 9 */}\n        <div className=\"flex flex-col items-center text-center space-y-3\">\n          <div className=\"w-12 h-12 rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-center p-2 shadow-xs\">\n            <svg className=\"w-7 h-7 text-blue-600 fill-current\" viewBox=\"0 0 24 24\">\n              <path d=\"M12 3L1 9l11 6 9-4.91V17h2V9L12 3z\" />\n              <path d=\"M5 13.18v4.32L12 21l7-3.5v-4.32l-7 3.82-7-3.82z\" opacity=\"0.8\" />\n            </svg>\n          </div>\n          <h1 className=\"text-2xl sm:text-3xl font-black text-slate-900 tracking-tight\">\n            Welcome back\n          </h1>\n          <p className=\"text-xs sm:text-sm text-slate-500 font-medium\">\n            Sign in to continue to your dashboard.\n          </p>\n        </div>\n\n        {/* Form Fields matching Screenshot 9 */}\n        <form onSubmit={handleSubmit} className=\"space-y-4\">\n          <div className=\"space-y-1\">\n            <label className=\"text-xs font-bold text-slate-700\">Email Address</label>\n            <div className=\"relative\">\n              <Mail className=\"w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400\" />\n              <input\n                type=\"email\"\n                placeholder=\"name@example.com\"\n                value={email}\n                onChange={(e) => setEmail(e.target.value)}\n                required\n                className=\"w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white\"\n              />\n            </div>\n          </div>\n\n          <div className=\"space-y-1\">\n            <label className=\"text-xs font-bold text-slate-700\">Password</label>\n            <div className=\"relative\">\n              <Lock className=\"w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400\" />\n              <input\n                type={showPassword ? \'text\' : \'password\'}\n                placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                value={password}\n                onChange={(e) => setPassword(e.target.value)}\n                required\n                className=\"w-full pl-10 pr-10 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white\"\n              />\n              <button\n                type=\"button\"\n                onClick={() => setShowPassword(!showPassword)}\n                className=\"absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600\"\n              >\n                {showPassword ? <EyeOff className=\"w-4 h-4\" /> : <Eye className=\"w-4 h-4\" />}\n              </button>\n            </div>\n          </div>\n\n          {/* Remember Me & Forgot Password */}\n          <div className=\"flex items-center justify-between text-xs font-semibold pt-1\">\n            <label className=\"flex items-center gap-2 cursor-pointer text-slate-600\">\n              <input\n                type=\"checkbox\"\n                checked={rememberMe}\n                onChange={(e) => setRememberMe(e.target.checked)}\n                className=\"rounded border-slate-300 text-blue-600 focus:ring-blue-500\"\n              />\n              <span>Remember me</span>\n            </label>\n            <button\n              type=\"button\"\n              className=\"text-blue-600 hover:underline\"\n              onClick={() => alert(\'Password reset link sent to \' + (email || \'your email\'))}\n            >\n              Forgot password?\n            </button>\n          </div>\n\n          {/* Sign In Button */}\n          <button\n            type=\"submit\"\n            className=\"w-full flex items-center justify-center gap-2 py-3.5 rounded-2xl bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-extrabold text-sm shadow-lg shadow-blue-600/20 transition-all mt-3\"\n          >\n            <span>Sign In</span>\n            <ArrowRight className=\"w-4 h-4\" />\n          </button>\n        </form>\n\n        {/* Footer Link */}\n        <div className=\"text-center text-xs text-slate-500 font-medium\">\n          Don\'t have an account?{\' \'}\n          <button\n            onClick={() => onNavigate(\'register\')}\n            className=\"font-bold text-blue-600 hover:underline\"\n          >\n            Register\n          </button>\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
    }
