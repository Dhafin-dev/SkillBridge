      replacement_content: "import React, { useState } from \'react\';\nimport { ArrowLeft, CheckCircle2, AlertTriangle, MessageSquare, Briefcase, Check } from \'lucide-react\';\nimport { ScreenView } from \'../types\';\n\ninterface NotificationCenterProps {\n  onNavigate: (screen: ScreenView) => void;\n}\n\nexport const NotificationCenter: React.FC<NotificationCenterProps> = ({ onNavigate }) => {\n  const [filter, setFilter] = useState<\'All\' | \'Projects\' | \'Messages\' | \'System\'>(\'All\');\n  const [readAll, setRead] = useState(false);\n\n  const notifications = [\n    {\n      id: \'n1\',\n      title: \'Application Accepted\',\n      time: \'2m ago\',\n      text: \'Your application for the \"E-commerce Redesign\" project has been accepted by the UMKM partner. Click to view next steps.\',\n      type: \'project\',\n      unread: !readAll\n    },\n    {\n      id: \'n2\',\n      title: \'Deadline Tomorrow\',\n      time: \'1h ago\',\n      text: \'The initial wireframes for \"Tech Startup Landing Page\" are due tomorrow at 5:00 PM.\',\n      type: \'system\',\n      unread: !readAll\n    },\n    {\n      id: \'n3\',\n      title: \'New Message\',\n      time: \'3h ago\',\n      text: \'Budi from UMKM Maju Jaya sent you a message regarding the logo concepts.\',\n      type: \'message\',\n      unread: false\n    }\n  ];\n\n  return (\n    <div className=\"min-h-screen bg-[#f8f9ff] text-slate-900 pb-24 max-w-3xl mx-auto\">\n      <header className=\"sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200/80 px-4 py-3 flex items-center justify-between shadow-xs\">\n        <div className=\"flex items-center gap-3\">\n          <button\n            onClick={() => onNavigate(\'landing\')}\n            className=\"p-1.5 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-full transition-colors\"\n          >\n            <ArrowLeft className=\"w-5 h-5\" />\n          </button>\n          <h1 className=\"text-xl font-extrabold text-slate-900\">Notifications</h1>\n        </div>\n        <button\n          onClick={() => setRead(true)}\n          className=\"text-xs font-semibold text-blue-600 hover:underline\"\n        >\n          Mark all as read\n        </button>\n      </header>\n\n      <main className=\"p-4 space-y-4\">\n        {/* Filters */}\n        <div className=\"flex gap-2 overflow-x-auto pb-1 text-xs font-semibold\">\n          {([\'All\', \'Projects\', \'Messages\', \'System\'] as const).map(tab => (\n            <button\n              key={tab}\n              onClick={() => setFilter(tab)}\n              className={`px-4 py-1.5 rounded-full whitespace-nowrap transition-colors ${\n                filter === tab\n                  ? \'bg-blue-600 text-white shadow-xs\'\n                  : \'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50\'\n              }`}\n            >\n              {tab}\n            </button>\n          ))}\n        </div>\n\n        {/* List */}\n        <div className=\"space-y-3\">\n          {notifications.map((n) => (\n            <div\n              key={n.id}\n              className={`bg-white rounded-2xl p-4 flex gap-3.5 border transition-all ${\n                n.unread ? \'border-blue-300 shadow-xs\' : \'border-slate-200/80\'\n              }`}\n            >\n              <div className=\"w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0\">\n                {n.type === \'project\' ? <Briefcase className=\"w-5 h-5\" /> : n.type === \'message\' ? <MessageSquare className=\"w-5 h-5\" /> : <AlertTriangle className=\"w-5 h-5 text-amber-600\" />}\n              </div>\n              <div className=\"flex-1 space-y-1\">\n                <div className=\"flex justify-between items-start\">\n                  <h3 className=\"text-xs font-bold text-slate-900\">{n.title}</h3>\n                  <span className=\"text-[10px] text-slate-400\">{n.time}</span>\n                </div>\n                <p className=\"text-xs text-slate-600 leading-relaxed\">{n.text}</p>\n              </div>\n            </div>\n          ))}\n        </div>\n      </main>\n    </div>\n  );\n};\n"
    }
