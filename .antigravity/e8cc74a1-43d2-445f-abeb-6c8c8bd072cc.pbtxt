      replacement_content: "import React from \'react\';\nimport { X, Bell, CheckCircle2, MessageSquare, Sparkles, Briefcase } from \'lucide-react\';\n\ninterface NotificationDrawerProps {\n  onClose: () => void;\n}\n\nexport const NotificationDrawer: React.FC<NotificationDrawerProps> = ({ onClose }) => {\n  const notifications = [\n    {\n      id: \'n1\',\n      title: \'New Application Received\',\n      desc: \'Budi Santoso applied to Brand Identity & Digital Strategy Revamp.\',\n      time: \'10 min ago\',\n      type: \'apply\'\n    },\n    {\n      id: \'n2\',\n      title: \'Milestone Phase 2 Approved\',\n      desc: \'Urban Threads UMKM marked Phase 2: UI Design as 65% complete.\',\n      time: \'1 hour ago\',\n      type: \'progress\'\n    },\n    {\n      id: \'n3\',\n      title: \'New Message from Sarah Chen\',\n      desc: \'Sarah Chen sent an update for Social Media Revamp.\',\n      time: \'2 hours ago\',\n      type: \'chat\'\n    }\n  ];\n\n  return (\n    <div className=\"fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex justify-end\">\n      <div className=\"w-full max-w-sm bg-white h-full shadow-2xl p-5 space-y-5 flex flex-col animate-in slide-in-from-right duration-200\">\n        \n        {/* Header */}\n        <div className=\"flex items-center justify-between border-b border-slate-100 pb-3\">\n          <div className=\"flex items-center gap-2\">\n            <Bell className=\"w-5 h-5 text-blue-600\" />\n            <h3 className=\"text-lg font-extrabold text-slate-900\">Notifications</h3>\n          </div>\n          <button onClick={onClose} className=\"p-1.5 rounded-full hover:bg-slate-100 text-slate-400\">\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Notifications List */}\n        <div className=\"flex-1 overflow-y-auto space-y-3\">\n          {notifications.map(n => (\n            <div key={n.id} className=\"p-3.5 rounded-2xl bg-slate-50 border border-slate-100 space-y-1 hover:bg-blue-50/50 transition-colors\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-xs font-bold text-slate-900\">{n.title}</span>\n                <span className=\"text-[10px] text-slate-400 font-semibold\">{n.time}</span>\n              </div>\n              <p className=\"text-xs text-slate-600 leading-snug\">{n.desc}</p>\n            </div>\n          ))}\n        </div>\n\n        {/* Footer */}\n        <div className=\"pt-2 border-t border-slate-100 text-center\">\n          <button\n            onClick={onClose}\n            className=\"w-full py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-colors\"\n          >\n            Mark All as Read\n          </button>\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
    }
