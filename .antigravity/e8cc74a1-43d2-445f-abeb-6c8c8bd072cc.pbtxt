    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { SlidersHorizontal, Mail, Shield, Save, RotateCcw, Send, CheckCircle } from \'lucide-react\';\nimport { ScreenView } from \'../../types\';\n\ninterface PlatformSettingsProps {\n  onNavigate: (screen: ScreenView) => void;\n}\n\nexport const PlatformSettings: React.FC<PlatformSettingsProps> = ({ onNavigate }) => {\n  const [platformName, setPlatformName] = useState(\'SkillBridge Academic Hub\');\n  const [primaryColor, setPrimaryColor] = useState(\'#004AC6\');\n  const [timezone, setTimezone] = useState(\'(UTC+07:00) Jakarta\');\n  const [smtpHost, setSmtpHost] = useState(\'smtp.skillbridge.edu\');\n  const [senderEmail, setSenderEmail] = useState(\'noreply@skillbridge.edu\');\n  const [maintenanceMode, setMaintenanceMode] = useState(false);\n  const [autoBackups, setAutoBackups] = useState(true);\n  const [saved, setSaved] = useState(false);\n\n  const handleSave = () => {\n    setSaved(true);\n    setTimeout(() => setSaved(false), 3000);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#f8f9ff] text-slate-900 pb-24 pt-4 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto\">\n      {/* Sub-Nav */}\n      <div className=\"flex flex-wrap items-center gap-2 mb-6 bg-white p-2 rounded-2xl border border-slate-200/80 shadow-xs text-xs font-semibold overflow-x-auto\">\n        <button onClick={() => onNavigate(\'admin-overview\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Overview</button>\n        <button onClick={() => onNavigate(\'matching-management\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Matching AI</button>\n        <button onClick={() => onNavigate(\'admin-projects\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Projects</button>\n        <button onClick={() => onNavigate(\'user-management\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Users</button>\n        <button onClick={() => onNavigate(\'category-management\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Categories</button>\n        <button onClick={() => onNavigate(\'reports-analytics\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Analytics</button>\n        <button onClick={() => onNavigate(\'verification-center\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Verifications</button>\n        <button onClick={() => onNavigate(\'platform-settings\')} className=\"px-3.5 py-2 rounded-xl bg-blue-600 text-white shadow-xs\">Settings</button>\n      </div>\n\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4\">\n        <div>\n          <h1 className=\"text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight\">Platform Settings</h1>\n          <p className=\"text-xs sm:text-sm text-slate-500 mt-1\">Manage system-wide configuration, branding, and security controls.</p>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <button\n            onClick={() => {\n              setPlatformName(\'SkillBridge Academic Hub\');\n              setPrimaryColor(\'#004AC6\');\n            }}\n            className=\"px-4 py-2.5 rounded-2xl border border-slate-200 text-slate-700 bg-white font-semibold text-xs hover:bg-slate-50 transition-colors shadow-xs\"\n          >\n            Restore Default\n          </button>\n          <button\n            onClick={handleSave}\n            className=\"px-5 py-2.5 rounded-2xl bg-blue-600 text-white font-semibold text-xs hover:bg-blue-700 transition-colors shadow-xs flex items-center gap-2\"\n          >\n            <Save className=\"w-4 h-4\" />\n            <span>Save Changes</span>\n          </button>\n        </div>\n      </div>\n\n      {saved && (\n        <div className=\"mb-6 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-2xl text-xs font-bold flex items-center gap-2\">\n          <CheckCircle className=\"w-5 h-5 text-emerald-600\" />\n          <span>Platform configuration updated successfully.</span>\n        </div>\n      )}\n\n      {/* Settings Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n        {/* Main Column */}\n        <div className=\"lg:col-span-8 space-y-6\">\n          {/* General */}\n          <div className=\"bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs space-y-5\">\n            <div className=\"flex items-center gap-2 pb-3 border-b border-slate-100\">\n              <SlidersHorizontal className=\"w-5 h-5 text-blue-600\" />\n              <h2 className=\"text-base font-bold text-slate-900\">General Settings</h2>\n            </div>\n\n            <div className=\"space-y-4 text-xs font-semibold\">\n              <div>\n                <label className=\"block text-slate-500 mb-1\">Platform Name</label>\n                <input\n                  type=\"text\"\n                  value={platformName}\n                  onChange={(e) => setPlatformName(e.target.value)}\n                  className=\"w-full h-11 px-4 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-600\"\n                />\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div>\n                  <label className=\"block text-slate-500 mb-1\">Primary Brand Color</label>\n                  <div className=\"flex items-center gap-3 h-11 px-4 rounded-xl bg-slate-50 border border-slate-200\">\n                    <div className=\"w-5 h-5 rounded-full bg-blue-600 border border-slate-300\" />\n                    <span className=\"font-mono text-slate-800\">{primaryColor}</span>\n                  </div>\n                </div>\n\n                <div>\n                  <label className=\"block text-slate-500 mb-1\">Timezone</label>\n                  <select\n                    value={timezone}\n                    onChange={(e) => setTimezone(e.target.value)}\n                    className=\"w-full h-11 px-4 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-100\"\n                  >\n                    <option>(UTC+07:00) Jakarta</option>\n                    <option>(UTC+08:00) Singapore</option>\n                    <option>(UTC+00:00) GMT</option>\n                  </select>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Email Settings */}\n          <div className=\"bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs space-y-5\">\n            <div className=\"flex items-center gap-2 pb-3 border-b border-slate-100\">\n              <Mail className=\"w-5 h-5 text-blue-600\" />\n              <h2 className=\"text-base font-bold text-slate-900\">Email Delivery</h2>\n            </div>\n\n            <div className=\"space-y-4 text-xs font-semibold\">\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div>\n                  <label className=\"block text-slate-500 mb-1\">SMTP Host</label>\n                  <input\n                    type=\"text\"\n                    value={smtpHost}\n                    onChange={(e) => setSmtpHost(e.target.value)}\n                    className=\"w-full h-11 px-4 rounded-xl bg-slate-50 border border-slate-200 text-slate-900\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-slate-500 mb-1\">Sender Email</label>\n                  <input\n                    type=\"email\"\n                    value={senderEmail}\n                    onChange={(e) => setSenderEmail(e.target.value)}\n                    className=\"w-full h-11 px-4 rounded-xl bg-slate-50 border border-slate-200 text-slate-900\"\n                  />\n                </div>\n              </div>\n\n              <button\n                onClick={() => alert(\'Test email sent!\')}\n                className=\"px-4 py-2.5 rounded-xl border border-slate-200 text-slate-800 font-semibold text-xs hover:bg-slate-50 transition-colors flex items-center gap-2\"\n              >\n                <Send className=\"w-4 h-4 text-blue-600\" />\n                <span>Send Test Email</span>\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* Sidebar Controls */}\n        <div className=\"lg:col-span-4 space-y-6\">\n          <div className=\"bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs space-y-4\">\n            <h3 className=\"text-base font-bold text-slate-900\">System Controls</h3>\n\n            <div className=\"space-y-3\">\n              <div className=\"flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100\">\n                <div>\n                  <p className=\"text-xs font-bold text-slate-900\">Maintenance Mode</p>\n                  <p className=\"text-[11px] text-slate-500\">Restrict access to admins only.</p>\n                </div>\n                <input\n                  type=\"checkbox\"\n                  checked={maintenanceMode}\n                  onChange={(e) => setMaintenanceMode(e.target.checked)}\n                  className=\"w-5 h-5 accent-blue-600 rounded cursor-pointer\"\n                />\n              </div>\n\n              <div className=\"flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100\">\n                <div>\n                  <p className=\"text-xs font-bold text-slate-900\">Automatic Backups</p>\n                  <p className=\"text-[11px] text-slate-500\">Daily database snapshots.</p>\n                </div>\n                <input\n                  type=\"checkbox\"\n                  checked={autoBackups}\n                  onChange={(e) => setAutoBackups(e.target.checked)}\n                  className=\"w-5 h-5 accent-blue-600 rounded cursor-pointer\"\n                />\n              </div>\n            </div>\n          </div>\n\n          <div className=\"bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs space-y-4\">\n            <div className=\"flex items-center gap-2 pb-2 border-b border-slate-100\">\n              <Shield className=\"w-5 h-5 text-blue-600\" />\n              <h3 className=\"text-base font-bold text-slate-900\">Security</h3>\n            </div>\n\n            <div className=\"space-y-3 text-xs\">\n              <div className=\"p-3 rounded-xl bg-slate-50 flex items-start gap-2.5\">\n                <CheckCircle className=\"w-4 h-4 text-emerald-600 shrink-0 mt-0.5\" />\n                <div>\n                  <p className=\"font-bold text-slate-900\">Two-Factor Auth</p>\n                  <p className=\"text-[11px] text-slate-500\">Enforced for all admin accounts.</p>\n                </div>\n              </div>\n\n              <div className=\"p-3 rounded-xl bg-slate-50 flex items-start gap-2.5\">\n                <CheckCircle className=\"w-4 h-4 text-emerald-600 shrink-0 mt-0.5\" />\n                <div>\n                  <p className=\"font-bold text-slate-900\">Session Timeout</p>\n                  <p className=\"text-[11px] text-slate-500\">Inactive sessions expire in 30 mins.</p>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
