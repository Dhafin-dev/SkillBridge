    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { SlidersHorizontal, MoreVertical, MessageSquare, ExternalLink, AlertCircle, CheckCircle2, Clock, FolderKanban } from \'lucide-react\';\nimport { ActiveStudentProject } from \'../types\';\nimport { STUDENT_ACTIVE_PROJECTS } from \'../data/mockData\';\n\ninterface MyProjectsWorkspaceProps {\n  onOpenWorkspace: (project: ActiveStudentProject) => void;\n  onOpenChat: (project: ActiveStudentProject) => void;\n}\n\nexport const MyProjectsWorkspace: React.FC<MyProjectsWorkspaceProps> = ({\n  onOpenWorkspace,\n  onOpenChat\n}) => {\n  const [activeTab, setActiveTab] = useState<\'Pending\' | \'Active\' | \'Completed\'>(\'Active\');\n\n  return (\n    <div className=\"min-h-[calc(100vh-80px)] bg-[#f8f9ff] pb-24 pt-4 px-4 sm:px-6\">\n      <div className=\"max-w-3xl mx-auto space-y-5\">\n        \n        {/* Title */}\n        <h1 className=\"text-2xl sm:text-3xl font-black text-slate-900 tracking-tight\">\n          My Projects\n        </h1>\n\n        {/* Status Filter Tabs matching Screenshot 4 */}\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={() => setActiveTab(\'Pending\')}\n            className={`px-4 py-2 rounded-2xl text-xs sm:text-sm font-semibold transition-all ${\n              activeTab === \'Pending\'\n                ? \'bg-blue-600 text-white shadow-md shadow-blue-500/20\'\n                : \'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50\'\n            }`}\n          >\n            Pending <span className=\"ml-1 px-1.5 py-0.5 rounded-full bg-slate-100 text-slate-700 text-[10px]\">2</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'Active\')}\n            className={`px-4 py-2 rounded-2xl text-xs sm:text-sm font-semibold transition-all ${\n              activeTab === \'Active\'\n                ? \'bg-blue-600 text-white shadow-md shadow-blue-500/20\'\n                : \'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50\'\n            }`}\n          >\n            Active <span className=\"ml-1 px-1.5 py-0.5 rounded-full bg-blue-100 text-blue-800 text-[10px]\">3</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'Completed\')}\n            className={`px-4 py-2 rounded-2xl text-xs sm:text-sm font-semibold transition-all ${\n              activeTab === \'Completed\'\n                ? \'bg-blue-600 text-white shadow-md shadow-blue-500/20\'\n                : \'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50\'\n            }`}\n          >\n            Completed <span className=\"ml-1 px-1.5 py-0.5 rounded-full bg-slate-100 text-slate-700 text-[10px]\">1</span>\n          </button>\n        </div>\n\n        {/* Filter / Sort Button */}\n        <div className=\"flex items-center justify-start\">\n          <button className=\"flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 rounded-2xl text-xs font-bold text-slate-700 shadow-xs hover:bg-slate-50\">\n            <SlidersHorizontal className=\"w-3.5 h-3.5 text-slate-500\" />\n            <span>Filter / Sort</span>\n          </button>\n        </div>\n\n        {/* Active Projects Cards List matching Screenshot 4 */}\n        <div className=\"space-y-4\">\n          {STUDENT_ACTIVE_PROJECTS.map((proj) => (\n            <div\n              key={proj.id}\n              className=\"bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs space-y-5 hover:shadow-md transition-all\"\n            >\n              {/* Header Badge & Menu Row */}\n              <div className=\"flex items-center justify-between\">\n                <span className={`px-3 py-1 rounded-full text-xs font-bold ${\n                  proj.status === \'Urgent\'\n                    ? \'bg-amber-100 text-amber-900 border border-amber-200\'\n                    : \'bg-blue-100 text-blue-800 border border-blue-200\'\n                }`}>\n                  {proj.status}\n                </span>\n                <button className=\"text-slate-400 hover:text-slate-600 p-1\">\n                  <MoreVertical className=\"w-4 h-4\" />\n                </button>\n              </div>\n\n              {/* Title & UMKM Subtitle */}\n              <div>\n                <h3 className=\"text-xl font-extrabold text-slate-900 leading-tight\">\n                  {proj.title}\n                </h3>\n                <div className=\"flex items-center gap-1.5 text-xs font-semibold text-slate-500 mt-1\">\n                  <span>\360\237\217\252</span>\n                  <span>{proj.companyName}</span>\n                </div>\n              </div>\n\n              {/* Progress Bar Container matching Screenshot 4 */}\n              <div className=\"bg-slate-50 border border-slate-100 rounded-2xl p-4 space-y-2\">\n                <div className=\"flex items-center justify-between text-xs font-bold\">\n                  <span className=\"text-slate-800\">{proj.phaseName}</span>\n                  <span className={proj.dueAlert ? \"text-red-600 font-extrabold\" : \"text-slate-500\"}>\n                    {proj.dueDate}\n                  </span>\n                </div>\n\n                {/* Progress Bar Track */}\n                <div className=\"w-full h-2.5 bg-slate-200 rounded-full overflow-hidden\">\n                  <div\n                    className={`h-full rounded-full transition-all duration-500 ${\n                      proj.status === \'Urgent\' ? \'bg-amber-600\' : \'bg-blue-600\'\n                    }`}\n                    style={{ width: `${proj.progressPercent}%` }}\n                  ></div>\n                </div>\n\n                <div className=\"text-right text-xs font-extrabold text-slate-700 pt-0.5\">\n                  {proj.progressPercent}% Complete\n                </div>\n              </div>\n\n              {/* Workspace & Chat Action Buttons matching Screenshot 4 */}\n              <div className=\"grid grid-cols-2 gap-3 pt-1\">\n                <button\n                  onClick={() => onOpenWorkspace(proj)}\n                  className=\"py-3 rounded-2xl bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-bold text-xs transition-colors shadow-md shadow-blue-600/15\"\n                >\n                  Workspace\n                </button>\n                <button\n                  onClick={() => onOpenChat(proj)}\n                  className=\"flex items-center justify-center gap-2 py-3 rounded-2xl bg-blue-50 hover:bg-blue-100 text-blue-700 font-bold text-xs border border-blue-200 transition-colors\"\n                >\n                  <MessageSquare className=\"w-4 h-4\" />\n                  <span>Chat</span>\n                </button>\n              </div>\n\n            </div>\n          ))}\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
    }
