      replacement_content: "import React from \'react\';\nimport { Briefcase, CheckCircle, Award, TrendingUp, Calendar, ChevronRight } from \'lucide-react\';\nimport { ScreenView } from \'../types\';\nimport { CURRENT_USER_STUDENT } from \'../data/mockData\';\n\ninterface StudentDashboardProps {\n  onNavigate: (screen: ScreenView) => void;\n}\n\nexport const StudentDashboard: React.FC<StudentDashboardProps> = ({ onNavigate }) => {\n  const monthlyData = [\n    { month: \'Jul\', count: 2 },\n    { month: \'Aug\', count: 4 },\n    { month: \'Sep\', count: 7 },\n    { month: \'Oct\', count: 5 },\n    { month: \'Nov\', count: 3 },\n  ];\n\n  const maxCount = Math.max(...monthlyData.map(d => d.count));\n\n  return (\n    <div className=\"min-h-[calc(100vh-80px)] bg-[#f8f9ff] pb-24 pt-4 px-4 sm:px-6\">\n      <div className=\"max-w-3xl mx-auto space-y-5\">\n        \n        {/* Header Greeting matching Screenshot 11 */}\n        <div className=\"space-y-1\">\n          <h1 className=\"text-2xl sm:text-3xl font-black text-slate-900 tracking-tight\">\n            Welcome back, {CURRENT_USER_STUDENT.name.split(\' \')[0]}\n          </h1>\n          <p className=\"text-xs sm:text-sm font-medium text-slate-500\">\n            Here\'s your academic and project overview.\n          </p>\n        </div>\n\n        {/* Metric Cards Grid matching Screenshot 11 */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n          {/* Active Projects Card */}\n          <div className=\"bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs space-y-2 relative\">\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-xs font-semibold text-slate-600\">Active Projects</span>\n              <div className=\"p-2 rounded-xl bg-slate-100 text-slate-400\">\n                <Briefcase className=\"w-5 h-5\" />\n              </div>\n            </div>\n            <div className=\"text-4xl font-black text-slate-900 leading-none\">\n              3\n            </div>\n          </div>\n\n          {/* Completed Projects Card */}\n          <div className=\"bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs space-y-2 relative\">\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-xs font-semibold text-slate-600\">Completed Projects</span>\n              <div className=\"p-2 rounded-xl bg-slate-100 text-slate-400\">\n                <CheckCircle className=\"w-5 h-5 text-emerald-500\" />\n              </div>\n            </div>\n            <div className=\"flex items-baseline gap-2\">\n              <span className=\"text-4xl font-black text-slate-900 leading-none\">12</span>\n              <span className=\"px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold\">\n                +2 this month\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Portfolio Score Banner Card matching Screenshot 11 */}\n        <div className=\"bg-gradient-to-r from-blue-600 to-blue-700 rounded-3xl p-6 text-white shadow-lg shadow-blue-600/20 flex items-center justify-between relative overflow-hidden\">\n          <div className=\"space-y-1 z-10\">\n            <span className=\"text-xs font-semibold opacity-90 block\">Portfolio Score</span>\n            <div className=\"text-5xl font-black tracking-tight leading-none\">\n              {CURRENT_USER_STUDENT.portfolioScore}\n            </div>\n          </div>\n          <div className=\"px-3.5 py-1.5 rounded-full bg-white/20 backdrop-blur-md text-xs font-bold text-white border border-white/30 z-10\">\n            Top 5% Student\n          </div>\n        </div>\n\n        {/* Recent Projects List matching Screenshot 11 */}\n        <div className=\"bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <h2 className=\"text-xl font-extrabold text-slate-900 tracking-tight\">\n              Recent Projects\n            </h2>\n            <button \n              onClick={() => onNavigate(\'my-projects\')}\n              className=\"text-xs font-bold text-blue-600 hover:text-blue-700 flex items-center gap-0.5\"\n            >\n              <span>View All</span>\n              <ChevronRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n\n          <div className=\"space-y-3\">\n            {/* Project 1 */}\n            <div className=\"flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 border border-slate-100 hover:bg-slate-100/70 transition-colors\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center text-blue-700 font-bold text-sm\">\n                  \360\237\217\252\n                </div>\n                <div>\n                  <h4 className=\"text-sm font-bold text-slate-900\">Local Cafe Rebranding</h4>\n                  <p className=\"text-xs text-slate-500 font-medium\">Marketing Strategy</p>\n                </div>\n              </div>\n              <div className=\"text-right\">\n                <span className=\"px-2.5 py-1 rounded-full bg-blue-100 text-blue-800 text-[10px] font-bold block mb-1\">\n                  In Progress\n                </span>\n                <span className=\"text-[11px] font-semibold text-slate-500\">Due in 5 days</span>\n              </div>\n            </div>\n\n            {/* Project 2 */}\n            <div className=\"flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 border border-slate-100 hover:bg-slate-100/70 transition-colors\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center text-blue-700 font-bold text-sm\">\n                  &lt;&gt;\n                </div>\n                <div>\n                  <h4 className=\"text-sm font-bold text-slate-900\">Inventory System App</h4>\n                  <p className=\"text-xs text-slate-500 font-medium\">Software Development</p>\n                </div>\n              </div>\n              <div className=\"text-right\">\n                <span className=\"px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold block mb-1\">\n                  Completed\n                </span>\n                <span className=\"text-[11px] font-semibold text-slate-500\">Last week</span>\n              </div>\n            </div>\n\n            {/* Project 3 */}\n            <div className=\"flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 border border-slate-100 hover:bg-slate-100/70 transition-colors\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center text-blue-700 font-bold text-sm\">\n                  \360\237\223\212\n                </div>\n                <div>\n                  <h4 className=\"text-sm font-bold text-slate-900\">Sales Data Analysis</h4>\n                  <p className=\"text-xs text-slate-500 font-medium\">Data Science</p>\n                </div>\n              </div>\n              <div className=\"text-right\">\n                <span className=\"px-2.5 py-1 rounded-full bg-blue-100 text-blue-800 text-[10px] font-bold block mb-1\">\n                  In Progress\n                </span>\n                <span className=\"text-[11px] font-semibold text-slate-500\">Due in 2 weeks</span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Monthly Activity Bar Chart matching Screenshot 11 */}\n        <div className=\"bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs space-y-6\">\n          <h2 className=\"text-xl font-extrabold text-slate-900 tracking-tight\">\n            Monthly Activity\n          </h2>\n\n          <div className=\"pt-6 pb-2\">\n            <div className=\"flex items-end justify-between gap-4 h-36 px-4 border-b border-slate-100\">\n              {monthlyData.map((d) => {\n                const heightPercent = (d.count / maxCount) * 100;\n                const isSelected = d.month === \'Sep\';\n\n                return (\n                  <div key={d.month} className=\"flex flex-col items-center gap-2 flex-1 group cursor-pointer\">\n                    <div className=\"w-full flex items-end justify-center h-28\">\n                      <div\n                        className={`w-full max-w-[36px] rounded-t-lg transition-all ${\n                          isSelected ? \'bg-blue-600 shadow-md shadow-blue-500/30\' : \'bg-blue-100 group-hover:bg-blue-200\'\n                        }`}\n                        style={{ height: `${heightPercent}%` }}\n                      ></div>\n                    </div>\n                    <span className={`text-xs font-bold ${isSelected ? \'text-blue-700\' : \'text-slate-400\'}`}>\n                      {d.month}\n                    </span>\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
    }
