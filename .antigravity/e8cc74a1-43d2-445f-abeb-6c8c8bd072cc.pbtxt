    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState } from \'react\';\nimport { UserProfile, ScreenView, Role, Project, ActiveStudentProject, ClientRequest, StudentCandidate } from \'./types\';\nimport { CURRENT_USER_STUDENT, CURRENT_USER_UMKM, PROJECTS_LIST, FEATURED_PROJECT, RECOMMENDED_STUDENTS } from \'./data/mockData\';\n\nimport { Navbar } from \'./components/Navbar\';\nimport { BottomNav } from \'./components/BottomNav\';\nimport { LandingHero } from \'./components/LandingHero\';\nimport { ProjectMarket } from \'./components/ProjectMarket\';\nimport { ProjectDetails } from \'./components/ProjectDetails\';\nimport { RecommendedStudents } from \'./components/RecommendedStudents\';\nimport { MyProjectsWorkspace } from \'./components/MyProjectsWorkspace\';\nimport { MyRequestsClient } from \'./components/MyRequestsClient\';\nimport { StudentDashboard } from \'./components/StudentDashboard\';\nimport { AdminOverview } from \'./components/AdminOverview\';\nimport { Register } from \'./components/Auth/Register\';\nimport { Login } from \'./components/Auth/Login\';\n\nimport { ApplyModal } from \'./components/Modals/ApplyModal\';\nimport { WorkspaceModal } from \'./components/Modals/WorkspaceModal\';\nimport { ChatModal } from \'./components/Modals/ChatModal\';\nimport { CreateProjectModal } from \'./components/Modals/CreateProjectModal\';\nimport { AIMatchModal } from \'./components/Modals/AIMatchModal\';\nimport { NotificationDrawer } from \'./components/NotificationDrawer\';\n\nexport default function App() {\n  const [currentUser, setCurrentUser] = useState<UserProfile>(CURRENT_USER_STUDENT);\n  const [currentScreen, setCurrentScreen] = useState<ScreenView>(\'market\');\n  const [selectedProject, setSelectedProject] = useState<Project>(PROJECTS_LIST[0]);\n  const [allProjects, setAllProjects] = useState<Project[]>(PROJECTS_LIST);\n\n  // Modal states\n  const [applyModalProject, setApplyModalProject] = useState<Project | null>(null);\n  const [workspaceModalProject, setWorkspaceModalProject] = useState<ActiveStudentProject | null>(null);\n  const [activeChat, setActiveChat] = useState<{\n    projectTitle: string;\n    partnerName: string;\n    partnerAvatar: string;\n    projectId?: string;\n  } | null>(null);\n\n  const [showCreateProjectModal, setShowCreateProjectModal] = useState(false);\n  const [showAiMatchModal, setShowAiMatchModal] = useState(false);\n  const [showNotifications, setShowNotifications] = useState(false);\n\n  // Switching role handler\n  const handleSwitchUser = (role: Role) => {\n    if (role === \'student\') {\n      setCurrentUser(CURRENT_USER_STUDENT);\n    } else if (role === \'umkm\') {\n      setCurrentUser(CURRENT_USER_UMKM);\n    } else if (role === \'admin\') {\n      setCurrentUser({\n        id: \'u-admin\',\n        name: \'Platform Administrator\',\n        email: \'admin@skillbridge.edu\',\n        role: \'admin\',\n        avatar: \'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=150&auto=format&fit=crop&q=80\'\n      });\n    }\n  };\n\n  const handleApplyClick = (proj: Project) => {\n    setApplyModalProject(proj);\n  };\n\n  const handleSelectProject = (proj: Project) => {\n    setSelectedProject(proj);\n    setCurrentScreen(\'project-details\');\n  };\n\n  const handleCreateNewProject = (newProjPartial: Partial<Project>) => {\n    const created: Project = {\n      id: \'proj-\' + Date.now(),\n      title: newProjPartial.title || \'Untitled Request\',\n      companyName: newProjPartial.companyName || \'Lumina Beans Roastery\',\n      companyLogo: newProjPartial.companyLogo || \'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=120&auto=format&fit=crop&q=80\',\n      matchScore: newProjPartial.matchScore || 92,\n      stipend: newProjPartial.stipend || \'$200\',\n      description: newProjPartial.description || \'\',\n      tags: newProjPartial.tags || [\'Figma\', \'Branding\'],\n      level: newProjPartial.level || \'Intermediate\',\n      duration: newProjPartial.duration || \'2 Months\',\n      appliedCount: 0,\n      category: newProjPartial.category || \'UI/UX Design\',\n      deadline: newProjPartial.deadline || \'Nov 30, 2024\',\n      teamSize: newProjPartial.teamSize || \'2 Students\',\n      overview: newProjPartial.description,\n      objectives: [\n        \'Deliver modern high-converting digital assets\',\n        \'Establish standard guidelines for internal team\',\n        \'Provide responsive handoff documentation\'\n      ],\n      deliverables: [\n        \'Production Codebase / Vector Assets\',\n        \'Brand Guideline Documentation\'\n      ],\n      aboutUmkm: \'Female-founded specialty roastery scaling its direct-to-consumer footprint.\'\n    };\n\n    setAllProjects([created, ...allProjects]);\n    setShowCreateProjectModal(false);\n    setSelectedProject(created);\n    setCurrentScreen(\'project-details\');\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#f8f9ff] font-sans antialiased text-slate-900 selection:bg-blue-100 selection:text-blue-900\">\n      \n      {/* Top Navbar */}\n      <Navbar\n        currentUser={currentUser}\n        currentScreen={currentScreen}\n        onNavigate={setCurrentScreen}\n        onSwitchUser={handleSwitchUser}\n        onOpenNotifications={() => setShowNotifications(true)}\n        onOpenCreateProject={() => setShowCreateProjectModal(true)}\n        onOpenAiMatch={() => setShowAiMatchModal(true)}\n      />\n\n      {/* Main Screen Content Body */}\n      <main className=\"w-full\">\n        {currentScreen === \'landing\' && (\n          <LandingHero onNavigate={setCurrentScreen} />\n        )}\n\n        {currentScreen === \'market\' && (\n          <ProjectMarket\n            onSelectProject={handleSelectProject}\n            onApplyProject={handleApplyClick}\n            onNavigate={setCurrentScreen}\n          />\n        )}\n\n        {currentScreen === \'project-details\' && (\n          <ProjectDetails\n            project={selectedProject}\n            onBack={() => setCurrentScreen(\'market\')}\n            onApply={handleApplyClick}\n            onViewUmkmProfile={(comp) => {\n              alert(`Viewing UMKM Profile for ${comp}`);\n            }}\n          />\n        )}\n\n        {currentScreen === \'students\' && (\n          <RecommendedStudents\n            onBack={() => setCurrentScreen(\'market\')}\n            onInviteStudent={(student) => {\n              setActiveChat({\n                projectTitle: selectedProject?.title || \'Brand Identity Revamp\',\n                partnerName: student.name,\n                partnerAvatar: student.avatar\n              });\n            }}\n            onViewProfile={(student) => {\n              setShowAiMatchModal(true);\n            }}\n          />\n        )}\n\n        {currentScreen === \'my-projects\' && (\n          <MyProjectsWorkspace\n            onOpenWorkspace={(proj) => setWorkspaceModalProject(proj)}\n            onOpenChat={(proj) => {\n              setActiveChat({\n                projectTitle: proj.title,\n                partnerName: proj.companyName,\n                partnerAvatar: proj.companyLogo || \'https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=120&auto=format&fit=crop&q=80\',\n                projectId: proj.id\n              });\n            }}\n          />\n        )}\n\n        {currentScreen === \'my-requests\' && (\n          <MyRequestsClient\n            onOpenCreateRequest={() => setShowCreateProjectModal(true)}\n            onOpenChat={(req) => {\n              setActiveChat({\n                projectTitle: req.title,\n                partnerName: req.assignedStudent || \'Sarah Chen\',\n                partnerAvatar: req.assignedStudentAvatar || \'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=150&auto=format&fit=crop&q=80\'\n              });\n            }}\n            onViewRequest={(req) => {\n              setCurrentScreen(\'students\');\n            }}\n          />\n        )}\n\n        {currentScreen === \'student-dashboard\' && (\n          <StudentDashboard onNavigate={setCurrentScreen} />\n        )}\n\n        {currentScreen === \'admin-overview\' && (\n          <AdminOverview onNavigate={setCurrentScreen} />\n        )}\n\n        {currentScreen === \'register\' && (\n          <Register\n            onRegisterSuccess={(role, name, email) => {\n              handleSwitchUser(role);\n              setCurrentUser(prev => ({ ...prev, name, email, role }));\n              if (role === \'student\') setCurrentScreen(\'student-dashboard\');\n              else setCurrentScreen(\'my-requests\');\n            }}\n            onNavigate={setCurrentScreen}\n          />\n        )}\n\n        {currentScreen === \'login\' && (\n          <Login\n            onLoginSuccess={(email) => {\n              setCurrentUser(prev => ({ ...prev, email }));\n              if (currentUser.role === \'student\') setCurrentScreen(\'student-dashboard\');\n              else setCurrentScreen(\'my-requests\');\n            }}\n            onNavigate={setCurrentScreen}\n          />\n        )}\n      </main>\n\n      {/* Sticky Bottom Navigation Bar */}\n      <BottomNav\n        currentScreen={currentScreen}\n        currentUserRole={currentUser.role}\n        onNavigate={setCurrentScreen}\n      />\n\n      {/* Application Modals */}\n      {applyModalProject && (\n        <ApplyModal\n          project={applyModalProject}\n          onClose={() => setApplyModalProject(null)}\n          onSubmit={(pitch) => {\n            setApplyModalProject(null);\n            setCurrentScreen(\'my-projects\');\n          }}\n        />\n      )}\n\n      {workspaceModalProject && (\n        <WorkspaceModal\n          project={workspaceModalProject}\n          onClose={() => setWorkspaceModalProject(null)}\n        />\n      )}\n\n      {activeChat && (\n        <ChatModal\n          projectTitle={activeChat.projectTitle}\n          partnerName={activeChat.partnerName}\n          partnerAvatar={activeChat.partnerAvatar}\n          currentUser={currentUser}\n          projectId={activeChat.projectId}\n          onClose={() => setActiveChat(null)}\n        />\n      )}\n\n      {showCreateProjectModal && (\n        <CreateProjectModal\n          onClose={() => setShowCreateProjectModal(false)}\n          onCreate={handleCreateNewProject}\n        />\n      )}\n\n      {showAiMatchModal && (\n        <AIMatchModal\n          project={selectedProject}\n          student={RECOMMENDED_STUDENTS[0]}\n          onClose={() => setShowAiMatchModal(false)}\n        />\n      )}\n\n      {showNotifications && (\n        <NotificationDrawer\n          onClose={() => setShowNotifications(false)}\n        />\n      )}\n\n    </div>\n  );\n}\n"
    }
