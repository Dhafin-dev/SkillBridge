  file_change {
    absolute_path_uri: "file:///src/components/Navbar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Search, Bell, Sparkles, ChevronDown, User, Shield, Briefcase, GraduationCap, Plus, LogOut, Check } from \'lucide-react\';\nimport { UserProfile, ScreenView, Role } from \'../types\';\n\ninterface NavbarProps {\n  currentUser: UserProfile;\n  currentScreen: ScreenView;\n  onNavigate: (screen: ScreenView) => void;\n  onSwitchUser: (role: Role) => void;\n  onOpenNotifications: () => void;\n  onOpenCreateProject?: () => void;\n  onOpenAiMatch?: () => void;\n  unreadCount?: number;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  currentUser,\n  currentScreen,\n  onNavigate,\n  onSwitchUser,\n  onOpenNotifications,\n  onOpenCreateProject,\n  onOpenAiMatch,\n  unreadCount = 2\n}) => {\n  const [showRoleMenu, setShowRoleMenu] = useState(false);\n  const [searchQuery, setSearchQuery] = useState(\'\');\n\n  return (\n    <header className=\"sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-100 shadow-xs px-4 py-3 transition-all\">\n      <div className=\"max-w-7xl mx-auto flex items-center justify-between gap-3\">\n        {/* Brand Logo */}\n        <div \n          onClick={() => onNavigate(\'market\')} \n          className=\"flex items-center gap-2.5 cursor-pointer group select-none\"\n        >\n          <div className=\"w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center text-white shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform\">\n            {/* Custom Graduation Cap Building Icon matching Screenshot 6 */}\n            <svg className=\"w-6 h-6 fill-current\" viewBox=\"0 0 24 24\">\n              <path d=\"M12 3L1 9l11 6 9-4.91V17h2V9L12 3z\" />\n              <path d=\"M5 13.18v4.32L12 21l7-3.5v-4.32l-7 3.82-7-3.82z\" opacity=\"0.8\" />\n              <path d=\"M9 16v3h2v-3H9zm4 0v3h2v-3h-2z\" />\n            </svg>\n          </div>\n          <div className=\"flex flex-col\">\n            <span className=\"text-xl font-bold tracking-tight text-blue-700 leading-none\">\n              SkillBridge\n            </span>\n            <span className=\"text-[10px] font-semibold text-blue-500 uppercase tracking-wider mt-0.5 hidden sm:inline\">\n              Academia \303\227 Enterprise\n            </span>\n          </div>\n        </div>\n\n        {/* Desktop Navigation Links */}\n        <nav className=\"hidden md:flex items-center gap-1 bg-slate-100/70 p-1 rounded-xl text-sm font-medium\">\n          <button\n            onClick={() => onNavigate(\'market\')}\n            className={`px-3.5 py-1.5 rounded-lg transition-all ${\n              currentScreen === \'market\' || currentScreen === \'project-details\'\n                ? \'bg-white text-blue-700 shadow-xs font-semibold\'\n                : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            Explore Projects\n          </button>\n          \n          {currentUser.role === \'student\' && (\n            <>\n              <button\n                onClick={() => onNavigate(\'my-projects\')}\n                className={`px-3.5 py-1.5 rounded-lg transition-all ${\n                  currentScreen === \'my-projects\'\n                    ? \'bg-white text-blue-700 shadow-xs font-semibold\'\n                    : \'text-slate-600 hover:text-slate-900\'\n                }`}\n              >\n                My Projects\n              </button>\n              <button\n                onClick={() => onNavigate(\'student-dashboard\')}\n                className={`px-3.5 py-1.5 rounded-lg transition-all ${\n                  currentScreen === \'student-dashboard\'\n                    ? \'bg-white text-blue-700 shadow-xs font-semibold\'\n                    : \'text-slate-600 hover:text-slate-900\'\n                }`}\n              >\n                Dashboard\n              </button>\n            </>\n          )}\n\n          {(currentUser.role === \'umkm\' || currentUser.role === \'admin\') && (\n            <>\n              <button\n                onClick={() => onNavigate(\'my-requests\')}\n                className={`px-3.5 py-1.5 rounded-lg transition-all ${\n                  currentScreen === \'my-requests\'\n                    ? \'bg-white text-blue-700 shadow-xs font-semibold\'\n                    : \'text-slate-600 hover:text-slate-900\'\n                }`}\n              >\n                My Requests\n              </button>\n              <button\n                onClick={() => onNavigate(\'students\')}\n                className={`px-3.5 py-1.5 rounded-lg transition-all ${\n                  currentScreen === \'students\'\n                    ? \'bg-white text-blue-700 shadow-xs font-semibold\'\n                    : \'text-slate-600 hover:text-slate-900\'\n                }`}\n              >\n                Find Students\n              </button>\n            </>\n          )}\n\n          <button\n            onClick={() => onNavigate(\'admin-overview\')}\n            className={`px-3.5 py-1.5 rounded-lg transition-all ${\n              currentScreen === \'admin-overview\'\n                ? \'bg-white text-blue-700 shadow-xs font-semibold\'\n                : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            Platform Stats\n          </button>\n        </nav>\n\n        {/* Right Action Icons & Controls */}\n        <div className=\"flex items-center gap-2\">\n          {/* Search Button / Bar */}\n          <div className=\"relative hidden sm:block\">\n            <Search className=\"w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" />\n            <input\n              type=\"text\"\n              placeholder=\"Search skills or projects...\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              className=\"pl-9 pr-3 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-lg w-40 md:w-56 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all\"\n            />\n          </div>\n\n          {/* AI Match Button */}\n          {onOpenAiMatch && (\n            <button\n              onClick={onOpenAiMatch}\n              className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-semibold transition-colors border border-indigo-200/60\"\n              title=\"AI Skill Matcher\"\n            >\n              <Sparkles className=\"w-3.5 h-3.5 text-indigo-600 animate-pulse\" />\n              <span className=\"hidden sm:inline\">AI Match</span>\n            </button>\n          )}\n\n          {/* Post Project button for UMKM */}\n          {currentUser.role === \'umkm\' && onOpenCreateProject && (\n            <button\n              onClick={onOpenCreateProject}\n              className=\"flex items-center gap-1 px-3 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold transition-colors shadow-xs\"\n            >\n              <Plus className=\"w-3.5 h-3.5\" />\n              <span className=\"hidden sm:inline\">New Request</span>\n            </button>\n          )}\n\n          {/* Bell Icon with Alert Badge */}\n          <button\n            onClick={onOpenNotifications}\n            className=\"relative p-2 rounded-lg text-slate-600 hover:bg-slate-100 transition-colors\"\n            aria-label=\"Notifications\"\n          >\n            <Bell className=\"w-5 h-5 text-slate-700\" />\n            {unreadCount > 0 && (\n              <span className=\"absolute top-1 right-1 w-2.5 h-2.5 bg-red-500 border-2 border-white rounded-full\"></span>\n            )}\n          </button>\n\n          {/* User Profile & Demo Switcher Menu */}\n          <div className=\"relative\">\n            <button\n              onClick={() => setShowRoleMenu(!showRoleMenu)}\n              className=\"flex items-center gap-2 p-1 rounded-full hover:bg-slate-100 transition-colors border border-slate-200/80\"\n            >\n              <img\n                src={currentUser.avatar}\n                alt={currentUser.name}\n                className=\"w-8 h-8 rounded-full object-cover ring-2 ring-blue-500/20\"\n              />\n              <ChevronDown className=\"w-3.5 h-3.5 text-slate-500 pr-0.5 hidden sm:block\" />\n            </button>\n\n            {/* Dropdown Menu */}\n            {showRoleMenu && (\n              <div \n                className=\"absolute right-0 mt-2 w-64 bg-white rounded-2xl shadow-xl border border-slate-100 p-2 z-50 animate-in fade-in slide-in-from-top-2 duration-150\"\n                onMouseLeave={() => setShowRoleMenu(false)}\n              >\n                <div className=\"px-3 py-2 border-b border-slate-100\">\n                  <p className=\"text-xs font-semibold text-slate-900 truncate\">{currentUser.name}</p>\n                  <p className=\"text-[11px] text-slate-500 truncate\">{currentUser.email}</p>\n                  <div className=\"mt-1.5 inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 text-[10px] font-bold uppercase tracking-wider\">\n                    {currentUser.role} mode\n                  </div>\n                </div>\n\n                <div className=\"py-1\">\n                  <div className=\"px-3 py-1 text-[10px] font-semibold text-slate-400 uppercase tracking-wider\">\n                    Switch Persona View\n                  </div>\n                  <button\n                    onClick={() => {\n                      onSwitchUser(\'student\');\n                      setShowRoleMenu(false);\n                      onNavigate(\'student-dashboard\');\n                    }}\n                    className={`w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium transition-colors ${\n                      currentUser.role === \'student\' ? \'bg-blue-50 text-blue-700 font-semibold\' : \'hover:bg-slate-50 text-slate-700\'\n                    }`}\n                  >\n                    <div className=\"flex items-center gap-2\">\n                      <GraduationCap className=\"w-4 h-4 text-blue-600\" />\n                      <span>Student (Alex Rivers)</span>\n                    </div>\n                    {currentUser.role === \'student\' && <Check className=\"w-4 h-4 text-blue-600\" />}\n                  </button>\n\n                  <button\n                    onClick={() => {\n                      onSwitchUser(\'umkm\');\n                      setShowRoleMenu(false);\n                      onNavigate(\'my-requests\');\n                    }}\n                    className={`w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium transition-colors ${\n                      currentUser.role === \'umkm\' ? \'bg-blue-50 text-blue-700 font-semibold\' : \'hover:bg-slate-50 text-slate-700\'\n                    }`}\n                  >\n                    <div className=\"flex items-center gap-2\">\n                      <Briefcase className=\"w-4 h-4 text-amber-600\" />\n                      <span>UMKM Client (Lumina Beans)</span>\n                    </div>\n                    {currentUser.role === \'umkm\' && <Check className=\"w-4 h-4 text-blue-600\" />}\n                  </button>\n\n                  <button\n                    onClick={() => {\n                      onSwitchUser(\'admin\');\n                      setShowRoleMenu(false);\n                      onNavigate(\'admin-overview\');\n                    }}\n                    className={`w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium transition-colors ${\n                      currentUser.role === \'admin\' ? \'bg-blue-50 text-blue-700 font-semibold\' : \'hover:bg-slate-50 text-slate-700\'\n                    }`}\n                  >\n                    <div className=\"flex items-center gap-2\">\n                      <Shield className=\"w-4 h-4 text-emerald-600\" />\n                      <span>Platform Admin View</span>\n                    </div>\n                    {currentUser.role === \'admin\' && <Check className=\"w-4 h-4 text-blue-600\" />}\n                  </button>\n                </div>\n\n                <div className=\"border-t border-slate-100 pt-1 mt-1\">\n                  <button\n                    onClick={() => {\n                      setShowRoleMenu(false);\n                      onNavigate(\'login\');\n                    }}\n                    className=\"w-full flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-medium text-red-600 hover:bg-red-50 transition-colors\"\n                  >\n                    <LogOut className=\"w-3.5 h-3.5\" />\n                    <span>Sign Out</span>\n                  </button>\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </header>\n  );\n};\n"
    }
    diff {
      unified_diff {
