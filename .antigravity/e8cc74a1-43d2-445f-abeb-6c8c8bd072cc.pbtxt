    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Search, Plus, CheckCircle, Clock, Hourglass, ShieldCheck, Calendar, ExternalLink, Edit2, Archive } from \'lucide-react\';\nimport { ScreenView } from \'../../types\';\n\ninterface AdminProjectManagementProps {\n  onNavigate: (screen: ScreenView) => void;\n}\n\nexport const AdminProjectManagement: React.FC<AdminProjectManagementProps> = ({ onNavigate }) => {\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [filterStatus, setFilterStatus] = useState<\'All\' | \'In Progress\' | \'Pending\' | \'Completed\'>(\'All\');\n\n  const projects = [\n    {\n      id: \'p1\',\n      title: \'E-Commerce Website Redesign\',\n      status: \'In Progress\',\n      umkm: \'Toko Kopi Sejahtera\',\n      student: \'Budi Santoso\',\n      progress: 65,\n      date: \'Oct 15, 2023\',\n      overdue: false\n    },\n    {\n      id: \'p2\',\n      title: \'Digital Marketing Strategy\',\n      status: \'Pending Review\',\n      umkm: \'Kerajinan Kayu Asri\',\n      student: \'Siti Aminah\',\n      progress: 100,\n      date: \'Oct 12, 2023\',\n      overdue: true\n    },\n    {\n      id: \'p3\',\n      title: \'Financial Audit & System Setup\',\n      status: \'Completed\',\n      umkm: \'Warung Nasi Bunda\',\n      student: \'Agus Setiawan\',\n      progress: 100,\n      date: \'Sep 20, 2023\',\n      overdue: false\n    }\n  ];\n\n  return (\n    <div className=\"min-h-screen bg-[#f8f9ff] text-slate-900 pb-24 pt-4 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto\">\n      {/* Top Admin Navigation */}\n      <div className=\"flex flex-wrap items-center gap-2 mb-6 bg-white p-2 rounded-2xl border border-slate-200/80 shadow-xs text-xs font-semibold overflow-x-auto\">\n        <button onClick={() => onNavigate(\'admin-overview\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Overview</button>\n        <button onClick={() => onNavigate(\'matching-management\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Matching AI</button>\n        <button onClick={() => onNavigate(\'admin-projects\')} className=\"px-3.5 py-2 rounded-xl bg-blue-600 text-white shadow-xs\">Projects</button>\n        <button onClick={() => onNavigate(\'user-management\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Users</button>\n        <button onClick={() => onNavigate(\'category-management\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Categories</button>\n        <button onClick={() => onNavigate(\'reports-analytics\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Analytics</button>\n        <button onClick={() => onNavigate(\'verification-center\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Verifications</button>\n        <button onClick={() => onNavigate(\'platform-settings\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Settings</button>\n      </div>\n\n      {/* Header & Actions */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4\">\n        <div>\n          <h1 className=\"text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight\">Project Management</h1>\n          <p className=\"text-xs sm:text-sm text-slate-500 mt-1\">Oversee UMKM projects and student assignments.</p>\n        </div>\n        <div className=\"w-full sm:w-auto flex flex-col sm:flex-row gap-3 items-center\">\n          <div className=\"relative w-full sm:w-64\">\n            <Search className=\"w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" />\n            <input\n              type=\"text\"\n              value={searchTerm}\n              onChange={(e) => setSearchTerm(e.target.value)}\n              placeholder=\"Search projects...\"\n              className=\"w-full pl-9 pr-4 py-2.5 bg-white border border-slate-200 rounded-2xl text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-600\"\n            />\n          </div>\n          <button\n            onClick={() => onNavigate(\'market\')}\n            className=\"w-full sm:w-auto h-11 px-5 bg-blue-600 hover:bg-blue-700 text-white rounded-2xl font-semibold text-xs transition-colors flex items-center justify-center gap-1.5 shadow-xs\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            <span>New Project</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Stats Bento Grid */}\n      <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8\">\n        <div className=\"bg-white rounded-2xl p-4 border border-slate-200/80 shadow-xs flex flex-col justify-between\">\n          <div className=\"flex items-center gap-2 text-slate-500 mb-2\">\n            <CheckCircle className=\"w-4 h-4 text-emerald-600\" />\n            <span className=\"text-[10px] font-bold uppercase tracking-wider\">Published</span>\n          </div>\n          <div className=\"text-3xl font-black text-slate-900\">1.2k</div>\n        </div>\n\n        <div className=\"bg-white rounded-2xl p-4 border border-slate-200/80 shadow-xs flex flex-col justify-between\">\n          <div className=\"flex items-center gap-2 text-slate-500 mb-2\">\n            <Clock className=\"w-4 h-4 text-amber-600\" />\n            <span className=\"text-[10px] font-bold uppercase tracking-wider\">Pending Review</span>\n          </div>\n          <div className=\"text-3xl font-black text-slate-900\">45</div>\n        </div>\n\n        <div className=\"bg-white rounded-2xl p-4 border border-slate-200/80 shadow-xs flex flex-col justify-between\">\n          <div className=\"flex items-center gap-2 text-slate-500 mb-2\">\n            <Hourglass className=\"w-4 h-4 text-blue-600\" />\n            <span className=\"text-[10px] font-bold uppercase tracking-wider\">In Progress</span>\n          </div>\n          <div className=\"text-3xl font-black text-slate-900\">850</div>\n        </div>\n\n        <div className=\"bg-white rounded-2xl p-4 border border-slate-200/80 shadow-xs flex flex-col justify-between\">\n          <div className=\"flex items-center gap-2 text-slate-500 mb-2\">\n            <ShieldCheck className=\"w-4 h-4 text-amber-700\" />\n            <span className=\"text-[10px] font-bold uppercase tracking-wider\">Completed</span>\n          </div>\n          <div className=\"text-3xl font-black text-slate-900\">3.0k</div>\n        </div>\n      </div>\n\n      {/* Filter Tabs */}\n      <div className=\"flex gap-2 mb-4 border-b border-slate-200/80 pb-3\">\n        {([\'All\', \'In Progress\', \'Pending\', \'Completed\'] as const).map((status) => (\n          <button\n            key={status}\n            onClick={() => setFilterStatus(status)}\n            className={`px-4 py-1.5 rounded-full text-xs font-semibold transition-colors ${\n              filterStatus === status\n                ? \'bg-blue-600 text-white\'\n                : \'text-slate-600 hover:bg-slate-100\'\n            }`}\n          >\n            {status}\n          </button>\n        ))}\n      </div>\n\n      {/* Project Cards List */}\n      <div className=\"space-y-3\">\n        {projects.map((proj) => (\n          <div\n            key={proj.id}\n            className=\"bg-white rounded-2xl shadow-xs border border-slate-200/80 p-5 flex flex-col md:flex-row gap-4 items-start md:items-center justify-between\"\n          >\n            <div className=\"flex-1 w-full\">\n              <div className=\"flex justify-between items-start mb-1\">\n                <h3 className=\"text-base font-bold text-slate-900\">{proj.title}</h3>\n                <span className={`inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase ${\n                  proj.status === \'Completed\'\n                    ? \'bg-emerald-100 text-emerald-800\'\n                    : proj.status === \'In Progress\'\n                    ? \'bg-blue-100 text-blue-800\'\n                    : \'bg-amber-100 text-amber-800\'\n                }`}>\n                  {proj.status}\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-500 mb-3\">\n                UMKM: <span className=\"font-semibold text-slate-700\">{proj.umkm}</span> \342\200\242 Student: <span className=\"font-semibold text-slate-700\">{proj.student}</span>\n              </p>\n              <div className=\"w-full max-w-md\">\n                <div className=\"flex justify-between text-[11px] font-semibold text-slate-500 mb-1\">\n                  <span>Progress</span>\n                  <span>{proj.progress}%</span>\n                </div>\n                <div className=\"w-full h-2 bg-slate-100 rounded-full overflow-hidden\">\n                  <div\n                    className={`h-full rounded-full ${proj.status === \'Completed\' ? \'bg-emerald-600\' : \'bg-blue-600\'}`}\n                    style={{ width: `${proj.progress}%` }}\n                  />\n                </div>\n              </div>\n            </div>\n\n            <div className=\"flex flex-row md:flex-col lg:flex-row gap-3 items-center w-full md:w-auto shrink-0 pt-2 md:pt-0 border-t md:border-t-0 border-slate-100\">\n              <div className=\"text-xs text-slate-500 flex items-center gap-1\">\n                <Calendar className=\"w-4 h-4 text-slate-400\" />\n                <span>{proj.date}</span>\n              </div>\n              <div className=\"flex gap-1\">\n                <button\n                  onClick={() => onNavigate(\'project-details\')}\n                  className=\"p-2 text-slate-500 hover:text-blue-600 hover:bg-slate-50 rounded-xl transition-colors\"\n                  title=\"Open Details\"\n                >\n                  <ExternalLink className=\"w-4 h-4\" />\n                </button>\n                <button\n                  className=\"p-2 text-slate-500 hover:text-blue-600 hover:bg-slate-50 rounded-xl transition-colors\"\n                  title=\"Edit\"\n                >\n                  <Edit2 className=\"w-4 h-4\" />\n                </button>\n                <button\n                  className=\"p-2 text-slate-500 hover:text-blue-600 hover:bg-slate-50 rounded-xl transition-colors\"\n                  title=\"Archive\"\n                >\n                  <Archive className=\"w-4 h-4\" />\n                </button>\n              </div>\n            </div>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};\n"
    }
