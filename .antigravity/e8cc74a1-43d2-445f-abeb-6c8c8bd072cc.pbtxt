      original_chunk {
        target_content: "  return (\n    <div className=\"min-h-[calc(100vh-80px)] bg-[#f8f9ff] pb-24 pt-4 px-4 sm:px-6\">\n      <div className=\"max-w-3xl mx-auto space-y-5\">\n        \n        {/* Header Title matching Screenshot 10 */}\n        <div className=\"space-y-1\">\n          <h1 className=\"text-2xl sm:text-3xl font-black text-slate-900 tracking-tight\">\n            Overview\n          </h1>\n          <p className=\"text-xs sm:text-sm font-medium text-slate-500\">\n            Comprehensive metrics and recent activities for platform management.\n          </p>\n        </div>"
        replacement_content: "  return (\n    <div className=\"min-h-[calc(100vh-80px)] bg-[#f8f9ff] pb-24 pt-4 px-4 sm:px-6\">\n      <div className=\"max-w-4xl mx-auto space-y-5\">\n        \n        {/* Admin Sub-Nav */}\n        <div className=\"flex flex-wrap items-center gap-2 bg-white p-2 rounded-2xl border border-slate-200/80 shadow-xs text-xs font-semibold overflow-x-auto\">\n          <button onClick={() => onNavigate(\'admin-overview\')} className=\"px-3.5 py-2 rounded-xl bg-blue-600 text-white shadow-xs\">Overview</button>\n          <button onClick={() => onNavigate(\'matching-management\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Matching AI</button>\n          <button onClick={() => onNavigate(\'admin-projects\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Projects</button>\n          <button onClick={() => onNavigate(\'user-management\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Users</button>\n          <button onClick={() => onNavigate(\'category-management\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Categories</button>\n          <button onClick={() => onNavigate(\'reports-analytics\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Analytics</button>\n          <button onClick={() => onNavigate(\'verification-center\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Verifications</button>\n          <button onClick={() => onNavigate(\'platform-settings\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Settings</button>\n        </div>\n\n        {/* Header Title */}\n        <div className=\"space-y-1\">\n          <h1 className=\"text-2xl sm:text-3xl font-black text-slate-900 tracking-tight\">\n            Overview\n          </h1>\n          <p className=\"text-xs sm:text-sm font-medium text-slate-500\">\n            Comprehensive metrics and recent activities for platform management.\n          </p>\n        </div>\n\n        {/* Quick Platform Controls */}\n        <div className=\"bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs space-y-3\">\n          <h3 className=\"text-sm font-bold text-slate-900\">Platform Management Modules</h3>\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n            <button\n              onClick={() => onNavigate(\'matching-management\')}\n              className=\"p-4 rounded-2xl bg-blue-50 hover:bg-blue-100 text-blue-800 font-bold text-xs text-left transition-colors flex items-center justify-between\"\n            >\n              <span>AI Matching Center</span>\n              <ArrowUpRight className=\"w-4 h-4\" />\n            </button>\n\n            <button\n              onClick={() => onNavigate(\'user-management\')}\n              className=\"p-4 rounded-2xl bg-indigo-50 hover:bg-indigo-100 text-indigo-800 font-bold text-xs text-left transition-colors flex items-center justify-between\"\n            >\n              <span>User Roster & Roles</span>\n              <ArrowUpRight className=\"w-4 h-4\" />\n            </button>\n\n            <button\n              onClick={() => onNavigate(\'reports-analytics\')}\n              className=\"p-4 rounded-2xl bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-bold text-xs text-left transition-colors flex items-center justify-between\"\n            >\n              <span>Growth Analytics</span>\n              <ArrowUpRight className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>"
      }
