  file_change {
    absolute_path_uri: "file:///src/components/Admin/CategoryManagement.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Search, Plus, Filter, Code, Palette, Megaphone, Edit2, Trash2 } from \'lucide-react\';\nimport { ScreenView } from \'../../types\';\n\ninterface CategoryManagementProps {\n  onNavigate: (screen: ScreenView) => void;\n}\n\nexport const CategoryManagement: React.FC<CategoryManagementProps> = ({ onNavigate }) => {\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [categories, setCategories] = useState([\n    {\n      id: \'c1\',\n      title: \'Web Development\',\n      description: \'Frontend, backend, and full-stack web applications for UMKMs.\',\n      count: 124,\n      icon: Code,\n      color: \'bg-blue-600\'\n    },\n    {\n      id: \'c2\',\n      title: \'Brand Identity\',\n      description: \'Logo design, brand guidelines, and visual assets.\',\n      count: 87,\n      icon: Palette,\n      color: \'bg-emerald-600\'\n    },\n    {\n      id: \'c3\',\n      title: \'Digital Marketing\',\n      description: \'Social media strategy, SEO, and content creation.\',\n      count: 56,\n      icon: Megaphone,\n      color: \'bg-amber-600\'\n    }\n  ]);\n\n  const handleCreateCategory = () => {\n    const title = prompt(\'Enter category name:\');\n    if (title) {\n      setCategories(prev => [\n        ...prev,\n        {\n          id: \'c\' + Date.now(),\n          title,\n          description: \'Custom specialization domain for student projects.\',\n          count: 0,\n          icon: Code,\n          color: \'bg-indigo-600\'\n        }\n      ]);\n    }\n  };\n\n  const handleDeleteCategory = (id: string) => {\n    if (confirm(\'Are you sure you want to delete this category?\')) {\n      setCategories(prev => prev.filter(c => c.id !== id));\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#f8f9ff] text-slate-900 pb-24 pt-4 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto\">\n      {/* Admin Nav */}\n      <div className=\"flex flex-wrap items-center gap-2 mb-6 bg-white p-2 rounded-2xl border border-slate-200/80 shadow-xs text-xs font-semibold overflow-x-auto\">\n        <button onClick={() => onNavigate(\'admin-overview\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Overview</button>\n        <button onClick={() => onNavigate(\'matching-management\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Matching AI</button>\n        <button onClick={() => onNavigate(\'admin-projects\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Projects</button>\n        <button onClick={() => onNavigate(\'user-management\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Users</button>\n        <button onClick={() => onNavigate(\'category-management\')} className=\"px-3.5 py-2 rounded-xl bg-blue-600 text-white shadow-xs\">Categories</button>\n        <button onClick={() => onNavigate(\'reports-analytics\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Analytics</button>\n        <button onClick={() => onNavigate(\'verification-center\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Verifications</button>\n        <button onClick={() => onNavigate(\'platform-settings\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Settings</button>\n      </div>\n\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4\">\n        <div>\n          <h1 className=\"text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight\">Categories</h1>\n          <p className=\"text-xs sm:text-sm text-slate-500 mt-1\">Manage project disciplines and specialization areas.</p>\n        </div>\n        <button\n          onClick={handleCreateCategory}\n          className=\"bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs px-5 h-10 rounded-2xl transition-colors shadow-xs flex items-center gap-1.5\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>Create Category</span>\n        </button>\n      </div>\n\n      {/* Search Bar */}\n      <div className=\"bg-white rounded-2xl p-4 mb-8 shadow-xs border border-slate-200/80 flex flex-col sm:flex-row gap-3\">\n        <div className=\"relative flex-1\">\n          <Search className=\"w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" />\n          <input\n            type=\"text\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            placeholder=\"Search categories...\"\n            className=\"w-full bg-slate-50 border border-slate-200 rounded-xl h-11 pl-9 pr-4 text-xs font-medium text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-600\"\n          />\n        </div>\n        <button className=\"bg-slate-100 text-slate-800 font-semibold text-xs px-4 py-2 rounded-xl h-11 flex items-center justify-center gap-1.5 hover:bg-slate-200 transition-colors\">\n          <Filter className=\"w-4 h-4\" />\n          <span>Filter</span>\n        </button>\n      </div>\n\n      {/* Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n        {categories.map((cat) => {\n          const IconComp = cat.icon;\n          return (\n            <div\n              key={cat.id}\n              className=\"bg-white rounded-2xl p-6 shadow-xs border border-slate-200/80 hover:shadow-md transition-all group relative overflow-hidden flex flex-col justify-between\"\n            >\n              <div>\n                <div className=\"flex justify-between items-start mb-6\">\n                  <div className=\"w-12 h-12 rounded-2xl bg-blue-50 flex items-center justify-center text-blue-600\">\n                    <IconComp className=\"w-6 h-6\" />\n                  </div>\n                  <div className=\"flex gap-1\">\n                    <button className=\"w-8 h-8 rounded-full flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors\">\n                      <Edit2 className=\"w-4 h-4\" />\n                    </button>\n                    <button\n                      onClick={() => handleDeleteCategory(cat.id)}\n                      className=\"w-8 h-8 rounded-full flex items-center justify-center text-slate-400 hover:text-red-600 hover:bg-red-50 transition-colors\"\n                    >\n                      <Trash2 className=\"w-4 h-4\" />\n                    </button>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-2 mb-1\">\n                  <div className={`w-2 h-2 rounded-full ${cat.color}`} />\n                  <h3 className=\"text-base font-bold text-slate-900\">{cat.title}</h3>\n                </div>\n                <p className=\"text-xs text-slate-500 mb-6 min-h-[36px] line-clamp-2\">\n                  {cat.description}\n                </p>\n              </div>\n\n              <div className=\"flex justify-between items-center border-t border-slate-100 pt-4\">\n                <span className=\"text-xs font-medium text-slate-500\">Active Projects</span>\n                <span className=\"text-xs font-bold bg-slate-100 text-slate-800 px-3 py-1 rounded-full\">\n                  {cat.count}\n                </span>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    }
