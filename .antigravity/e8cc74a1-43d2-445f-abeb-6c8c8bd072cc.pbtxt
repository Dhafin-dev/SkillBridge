  file_change {
    absolute_path_uri: "file:///src/components/Admin/VerificationCenter.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { School, Store, CheckCircle, XCircle, RotateCcw, ZoomIn } from \'lucide-react\';\nimport { ScreenView } from \'../../types\';\n\ninterface VerificationCenterProps {\n  onNavigate: (screen: ScreenView) => void;\n}\n\nexport const VerificationCenter: React.FC<VerificationCenterProps> = ({ onNavigate }) => {\n  const [activeTab, setActiveFilter] = useState<\'student\' | \'umkm\'>(\'student\');\n  const [students, setStudents] = useState([\n    {\n      id: \'v1\',\n      name: \'Sarah Jenkins\',\n      institution: \'University of Technology\',\n      docType: \'Student ID\',\n      date: \'Oct 24, 2023\',\n      photo: \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80\',\n      docScan: \'https://images.unsplash.com/photo-1589829545856-d10d557cf95f?w=600&auto=format&fit=crop&q=80\',\n      status: \'new\'\n    },\n    {\n      id: \'v2\',\n      name: \'David Chen\',\n      institution: \'Global Business School\',\n      docType: \'Transcript\',\n      date: \'Oct 24, 2023\',\n      photo: \'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&auto=format&fit=crop&q=80\',\n      docScan: \'https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?w=600&auto=format&fit=crop&q=80\',\n      status: \'new\'\n    }\n  ]);\n\n  const handleApprove = (id: string) => {\n    setStudents(prev => prev.filter(s => s.id !== id));\n    alert(\'Verification approved successfully!\');\n  };\n\n  const handleReject = (id: string) => {\n    setStudents(prev => prev.filter(s => s.id !== id));\n    alert(\'Verification rejected.\');\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#f8f9ff] text-slate-900 pb-24 pt-4 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto\">\n      {/* Sub-Nav */}\n      <div className=\"flex flex-wrap items-center gap-2 mb-6 bg-white p-2 rounded-2xl border border-slate-200/80 shadow-xs text-xs font-semibold overflow-x-auto\">\n        <button onClick={() => onNavigate(\'admin-overview\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Overview</button>\n        <button onClick={() => onNavigate(\'matching-management\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Matching AI</button>\n        <button onClick={() => onNavigate(\'admin-projects\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Projects</button>\n        <button onClick={() => onNavigate(\'user-management\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Users</button>\n        <button onClick={() => onNavigate(\'category-management\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Categories</button>\n        <button onClick={() => onNavigate(\'reports-analytics\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Analytics</button>\n        <button onClick={() => onNavigate(\'verification-center\')} className=\"px-3.5 py-2 rounded-xl bg-blue-600 text-white shadow-xs\">Verifications</button>\n        <button onClick={() => onNavigate(\'platform-settings\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Settings</button>\n      </div>\n\n      {/* Header & Tabs */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 mb-8\">\n        <div>\n          <h1 className=\"text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight\">Verification Center</h1>\n          <p className=\"text-xs sm:text-sm text-slate-500 mt-1\">Review and approve incoming registration documents.</p>\n        </div>\n\n        <div className=\"inline-flex bg-slate-100 p-1 rounded-2xl border border-slate-200/60 shadow-xs text-xs font-semibold\">\n          <button\n            onClick={() => setActiveFilter(\'student\')}\n            className={`px-4 py-2 rounded-xl transition-all flex items-center gap-1.5 ${\n              activeTab === \'student\' ? \'bg-blue-600 text-white shadow-xs\' : \'text-slate-600 hover:bg-slate-200/60\'\n            }`}\n          >\n            <School className=\"w-4 h-4\" />\n            <span>Student Verification</span>\n          </button>\n          <button\n            onClick={() => setActiveFilter(\'umkm\')}\n            className={`px-4 py-2 rounded-xl transition-all flex items-center gap-1.5 ${\n              activeTab === \'umkm\' ? \'bg-blue-600 text-white shadow-xs\' : \'text-slate-600 hover:bg-slate-200/60\'\n            }`}\n          >\n            <Store className=\"w-4 h-4\" />\n            <span>UMKM Verification</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Cards Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n        {students.map((st) => (\n          <div key={st.id} className=\"bg-white rounded-2xl p-5 shadow-xs border border-slate-200/80 flex flex-col justify-between\">\n            <div>\n              <div className=\"flex items-center gap-3 pb-4 border-b border-slate-100 mb-4\">\n                <img src={st.photo} alt={st.name} className=\"w-12 h-12 rounded-full object-cover shrink-0\" />\n                <div>\n                  <h3 className=\"text-base font-bold text-slate-900\">{st.name}</h3>\n                  <p className=\"text-xs text-slate-500\">{st.institution}</p>\n                </div>\n                <span className=\"ml-auto bg-blue-50 text-blue-700 text-[10px] font-bold px-2.5 py-0.5 rounded-full\">New</span>\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-2 text-xs mb-4\">\n                <div>\n                  <span className=\"text-slate-400 font-bold block text-[10px] uppercase\">Document Type</span>\n                  <span className=\"font-semibold text-slate-800\">{st.docType}</span>\n                </div>\n                <div>\n                  <span className=\"text-slate-400 font-bold block text-[10px] uppercase\">Submission Date</span>\n                  <span className=\"font-semibold text-slate-800\">{st.date}</span>\n                </div>\n              </div>\n\n              <div className=\"w-full h-40 bg-slate-100 rounded-xl overflow-hidden border border-slate-200 relative group cursor-pointer mb-4\">\n                <img src={st.docScan} alt=\"Document Scan\" className=\"w-full h-full object-cover\" />\n                <div className=\"absolute inset-0 bg-slate-900/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center backdrop-blur-xs\">\n                  <ZoomIn className=\"w-8 h-8 text-white\" />\n                </div>\n              </div>\n            </div>\n\n            <div className=\"flex gap-2 pt-2 border-t border-slate-100\">\n              <button\n                onClick={() => handleApprove(st.id)}\n                className=\"flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs h-10 rounded-xl flex items-center justify-center gap-1.5 transition-colors shadow-xs\"\n              >\n                <CheckCircle className=\"w-4 h-4\" />\n                <span>Approve</span>\n              </button>\n              <button\n                onClick={() => handleReject(st.id)}\n                className=\"flex-1 bg-white border border-slate-200 text-red-600 hover:bg-red-50 font-semibold text-xs h-10 rounded-xl flex items-center justify-center gap-1.5 transition-colors\"\n              >\n                <XCircle className=\"w-4 h-4\" />\n                <span>Reject</span>\n              </button>\n            </div>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};\n"
    }
