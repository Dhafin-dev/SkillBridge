  file_change {
    absolute_path_uri: "file:///src/components/RecommendedStudents.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { ArrowLeft, Search, SlidersHorizontal, CheckCircle2, Send, User, Award, Check } from \'lucide-react\';\nimport { StudentCandidate, ScreenView } from \'../types\';\nimport { RECOMMENDED_STUDENTS } from \'../data/mockData\';\n\ninterface RecommendedStudentsProps {\n  onBack: () => void;\n  onInviteStudent: (student: StudentCandidate) => void;\n  onViewProfile?: (student: StudentCandidate) => void;\n  projectName?: string;\n}\n\nexport const RecommendedStudents: React.FC<RecommendedStudentsProps> = ({\n  onBack,\n  onInviteStudent,\n  onViewProfile,\n  projectName = \"Digital Marketing\"\n}) => {\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [invitedMap, setInvitedMap] = useState<Record<string, boolean>>({});\n\n  const filteredStudents = RECOMMENDED_STUDENTS.filter(s =>\n    s.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n    s.institution.toLowerCase().includes(searchQuery.toLowerCase()) ||\n    s.skills.some(sk => sk.toLowerCase().includes(searchQuery.toLowerCase()))\n  );\n\n  const handleInvite = (student: StudentCandidate) => {\n    setInvitedMap(prev => ({ ...prev, [student.id]: true }));\n    onInviteStudent(student);\n  };\n\n  return (\n    <div className=\"min-h-[calc(100vh-80px)] bg-[#f8f9ff] pb-24 pt-3 px-4 sm:px-6\">\n      <div className=\"max-w-3xl mx-auto space-y-5\">\n        \n        {/* Header Bar matching Screenshot 3 */}\n        <div className=\"flex items-center gap-3 py-2\">\n          <button\n            onClick={onBack}\n            className=\"p-2 rounded-full bg-white hover:bg-slate-100 text-slate-700 transition-colors border border-slate-200 shadow-xs\"\n          >\n            <ArrowLeft className=\"w-5 h-5\" />\n          </button>\n          <div>\n            <h1 className=\"text-xl sm:text-2xl font-black text-slate-900 tracking-tight leading-tight\">\n              Recommended Students\n            </h1>\n            <p className=\"text-xs font-semibold text-slate-500\">\n              For \"{projectName}\" Project\n            </p>\n          </div>\n        </div>\n\n        {/* Search & Filter Controls matching Screenshot 3 */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-2.5\">\n          <div className=\"sm:col-span-2 relative\">\n            <Search className=\"w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400\" />\n            <input\n              type=\"text\"\n              placeholder=\"Search skills or name...\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              className=\"w-full pl-10 pr-4 py-2.5 bg-white border border-slate-200 rounded-2xl text-xs sm:text-sm font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-xs\"\n            />\n          </div>\n\n          <button className=\"flex items-center justify-center gap-2 px-4 py-2.5 bg-white border border-slate-200 rounded-2xl text-xs font-bold text-slate-700 shadow-xs hover:bg-slate-50\">\n            <SlidersHorizontal className=\"w-4 h-4 text-slate-500\" />\n            <span>Highest Match</span>\n          </button>\n        </div>\n\n        {/* Student Cards List */}\n        <div className=\"space-y-4\">\n          {filteredStudents.map((student) => {\n            const isInvited = invitedMap[student.id];\n\n            return (\n              <div\n                key={student.id}\n                className=\"bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs space-y-4 hover:shadow-md transition-all relative overflow-hidden\"\n              >\n                {/* Top Accent Line */}\n                <div className=\"h-1 w-full bg-gradient-to-r from-blue-500 to-emerald-400 absolute top-0 left-0 right-0\"></div>\n\n                {/* Profile Top Row */}\n                <div className=\"flex items-start justify-between gap-3 pt-1\">\n                  <div className=\"flex items-center gap-3.5\">\n                    <img\n                      src={student.avatar}\n                      alt={student.name}\n                      className=\"w-14 h-14 rounded-full object-cover ring-2 ring-slate-100 shadow-xs\"\n                    />\n                    <div>\n                      <h3 className=\"text-lg font-bold text-slate-900 leading-tight\">\n                        {student.name}\n                      </h3>\n                      <p className=\"text-xs font-medium text-slate-500 mt-0.5\">\n                        {student.institution}\n                      </p>\n                    </div>\n                  </div>\n\n                  {/* Match Score Badge */}\n                  <div className={`inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold shadow-xs ${\n                    student.matchScore >= 95\n                      ? \'bg-emerald-300/90 text-emerald-950 border border-emerald-400/30\'\n                      : \'bg-blue-100 text-blue-800 border border-blue-200\'\n                  }`}>\n                    <CheckCircle2 className=\"w-3.5 h-3.5 fill-current\" />\n                    <span>MATCH: {student.matchScore}%</span>\n                  </div>\n                </div>\n\n                {/* Score Stats Row matching Screenshot 3 */}\n                <div className=\"grid grid-cols-2 gap-4 py-3 border-y border-slate-100\">\n                  <div>\n                    <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider block\">\n                      PORTFOLIO SCORE\n                    </span>\n                    <span className=\"text-2xl font-black text-slate-900 leading-none\">\n                      {student.portfolioScore}\n                    </span>\n                  </div>\n                  <div>\n                    <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider block\">\n                      PROJECTS COMPLETED\n                    </span>\n                    <span className=\"text-2xl font-black text-slate-900 leading-none\">\n                      {student.projectsCompleted}\n                    </span>\n                  </div>\n                </div>\n\n                {/* Relevant Skills */}\n                <div className=\"space-y-1.5\">\n                  <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider block\">\n                    RELEVANT SKILLS\n                  </span>\n                  <div className=\"flex flex-wrap gap-1.5\">\n                    {student.skills.map(sk => (\n                      <span\n                        key={sk}\n                        className=\"px-3 py-1 rounded-lg bg-blue-50 text-blue-800 text-xs font-semibold border border-blue-100/60\"\n                      >\n                        {sk}\n                      </span>\n                    ))}\n                  </div>\n                </div>\n\n                {/* Action Buttons Row matching Screenshot 3 */}\n                <div className=\"grid grid-cols-2 gap-3 pt-2\">\n                  <button\n                    onClick={() => onViewProfile?.(student)}\n                    className=\"flex items-center justify-center gap-1.5 py-3 rounded-2xl bg-white border border-slate-200 text-slate-800 font-bold text-xs hover:bg-slate-50 transition-colors shadow-xs\"\n                  >\n                    <User className=\"w-3.5 h-3.5 text-slate-500\" />\n                    <span>View Profile</span>\n                  </button>\n\n                  <button\n                    onClick={() => handleInvite(student)}\n                    disabled={isInvited}\n                    className={`flex items-center justify-center gap-1.5 py-3 rounded-2xl font-bold text-xs transition-all shadow-md ${\n                      isInvited\n                        ? \'bg-emerald-600 text-white cursor-default\'\n                        : \'bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white shadow-blue-600/20\'\n                    }`}\n                  >\n                    {isInvited ? (\n                      <>\n                        <Check className=\"w-4 h-4\" />\n                        <span>Invited</span>\n                      </>\n                    ) : (\n                      <>\n                        <Send className=\"w-3.5 h-3.5\" />\n                        <span>Invite Student</span>\n                      </>\n                    )}\n                  </button>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
    }
