  file_change {
    absolute_path_uri: "file:///src/components/Admin/UserManagement.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Search, Filter, Plus, Users, GraduationCap, Store, Shield, CheckCircle, Clock, Eye, Edit2, ChevronLeft, ChevronRight } from \'lucide-react\';\nimport { ScreenView } from \'../../types\';\n\ninterface UserManagementProps {\n  onNavigate: (screen: ScreenView) => void;\n}\n\nexport const UserManagement: React.FC<UserManagementProps> = ({ onNavigate }) => {\n  const [searchTerm, setSearchTerm] = useState(\'\');\n\n  const usersList = [\n    {\n      id: \'u1\',\n      name: \'Alex Rivers\',\n      email: \'alex.rivers@university.edu\',\n      role: \'Student\',\n      verified: true,\n      status: \'Active\',\n      avatar: \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80\'\n    },\n    {\n      id: \'u2\',\n      name: \'Maya Bakery (UMKM)\',\n      email: \'contact@mayabakery.com\',\n      role: \'UMKM\',\n      verified: false,\n      status: \'Active\',\n      avatar: \'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=150&auto=format&fit=crop&q=80\'\n    },\n    {\n      id: \'u3\',\n      name: \'Budi Santoso\',\n      email: \'budi.santoso@cs.ui.ac.id\',\n      role: \'Student\',\n      verified: true,\n      status: \'Active\',\n      avatar: \'https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=150&auto=format&fit=crop&q=80\'\n    }\n  ];\n\n  return (\n    <div className=\"min-h-screen bg-[#f8f9ff] text-slate-900 pb-24 pt-4 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto\">\n      {/* Top Admin Sub-Nav */}\n      <div className=\"flex flex-wrap items-center gap-2 mb-6 bg-white p-2 rounded-2xl border border-slate-200/80 shadow-xs text-xs font-semibold overflow-x-auto\">\n        <button onClick={() => onNavigate(\'admin-overview\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Overview</button>\n        <button onClick={() => onNavigate(\'matching-management\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Matching AI</button>\n        <button onClick={() => onNavigate(\'admin-projects\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Projects</button>\n        <button onClick={() => onNavigate(\'user-management\')} className=\"px-3.5 py-2 rounded-xl bg-blue-600 text-white shadow-xs\">Users</button>\n        <button onClick={() => onNavigate(\'category-management\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Categories</button>\n        <button onClick={() => onNavigate(\'reports-analytics\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Analytics</button>\n        <button onClick={() => onNavigate(\'verification-center\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Verifications</button>\n        <button onClick={() => onNavigate(\'platform-settings\')} className=\"px-3.5 py-2 rounded-xl text-slate-600 hover:bg-slate-100 transition-colors\">Settings</button>\n      </div>\n\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4\">\n        <div>\n          <h1 className=\"text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight\">User Management</h1>\n          <p className=\"text-xs sm:text-sm text-slate-500 mt-1\">Oversee and manage platform users, roles, and verification status.</p>\n        </div>\n        <button\n          onClick={() => {\n            const name = prompt(\'Enter new user full name:\');\n            if (name) alert(`User ${name} invited.`);\n          }}\n          className=\"bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs px-5 h-10 rounded-xl transition-colors shadow-xs flex items-center gap-1.5\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>Add User</span>\n        </button>\n      </div>\n\n      {/* Stats Bento Grid */}\n      <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8\">\n        <div className=\"bg-white rounded-2xl p-4 border border-slate-200/80 shadow-xs\">\n          <div className=\"flex items-center justify-between text-slate-500 mb-2\">\n            <span className=\"text-xs font-bold\">Total Users</span>\n            <Users className=\"w-4 h-4 text-blue-600\" />\n          </div>\n          <div className=\"text-3xl font-black text-slate-900\">14,230</div>\n          <p className=\"text-[11px] font-bold text-emerald-600 mt-1\">+12% this month</p>\n        </div>\n\n        <div className=\"bg-white rounded-2xl p-4 border border-slate-200/80 shadow-xs\">\n          <div className=\"flex items-center justify-between text-slate-500 mb-2\">\n            <span className=\"text-xs font-bold\">Students</span>\n            <GraduationCap className=\"w-4 h-4 text-indigo-600\" />\n          </div>\n          <div className=\"text-3xl font-black text-slate-900\">9,450</div>\n        </div>\n\n        <div className=\"bg-white rounded-2xl p-4 border border-slate-200/80 shadow-xs\">\n          <div className=\"flex items-center justify-between text-slate-500 mb-2\">\n            <span className=\"text-xs font-bold\">UMKM</span>\n            <Store className=\"w-4 h-4 text-emerald-600\" />\n          </div>\n          <div className=\"text-3xl font-black text-slate-900\">4,678</div>\n        </div>\n\n        <div className=\"bg-white rounded-2xl p-4 border border-slate-200/80 shadow-xs\">\n          <div className=\"flex items-center justify-between text-slate-500 mb-2\">\n            <span className=\"text-xs font-bold\">Admins</span>\n            <Shield className=\"w-4 h-4 text-red-600\" />\n          </div>\n          <div className=\"text-3xl font-black text-slate-900\">102</div>\n        </div>\n      </div>\n\n      {/* Controls */}\n      <div className=\"flex flex-col sm:flex-row gap-3 mb-6\">\n        <div className=\"relative flex-1\">\n          <Search className=\"w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" />\n          <input\n            type=\"text\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            placeholder=\"Search users by name, email, or role...\"\n            className=\"w-full bg-white border border-slate-200 rounded-2xl h-11 pl-9 pr-4 text-xs font-medium text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-600\"\n          />\n        </div>\n        <button className=\"bg-white border border-slate-200 rounded-2xl h-11 px-4 flex items-center justify-center font-semibold text-xs text-slate-700 hover:bg-slate-50 transition-colors\">\n          <Filter className=\"w-4 h-4 mr-1.5\" />\n          <span>Filter</span>\n        </button>\n      </div>\n\n      {/* Table Container */}\n      <div className=\"bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden\">\n        {/* Table Header */}\n        <div className=\"hidden sm:grid grid-cols-12 gap-2 p-4 bg-slate-50/80 border-b border-slate-100 text-[11px] font-bold text-slate-400 uppercase tracking-wider\">\n          <div className=\"col-span-5\">User</div>\n          <div className=\"col-span-2\">Role</div>\n          <div className=\"col-span-2\">Verification</div>\n          <div className=\"col-span-2\">Status</div>\n          <div className=\"col-span-1 text-right\">Actions</div>\n        </div>\n\n        {/* User Rows */}\n        <div className=\"divide-y divide-slate-100\">\n          {usersList.map((user) => (\n            <div key={user.id} className=\"p-4 hover:bg-slate-50/60 transition-colors\">\n              <div className=\"grid grid-cols-1 sm:grid-cols-12 gap-2 items-center\">\n                <div className=\"col-span-1 sm:col-span-5 flex items-center gap-3\">\n                  <img\n                    src={user.avatar}\n                    alt={user.name}\n                    className=\"w-10 h-10 rounded-full object-cover border border-slate-200 shrink-0\"\n                  />\n                  <div className=\"overflow-hidden\">\n                    <h3 className=\"text-xs font-bold text-slate-900 truncate\">{user.name}</h3>\n                    <p className=\"text-[11px] text-slate-500 truncate\">{user.email}</p>\n                  </div>\n                </div>\n\n                <div className=\"col-span-1 sm:col-span-2 mt-1 sm:mt-0\">\n                  <span className=\"bg-slate-100 text-slate-800 px-2.5 py-0.5 rounded-full text-[11px] font-semibold\">\n                    {user.role}\n                  </span>\n                </div>\n\n                <div className=\"col-span-1 sm:col-span-2 mt-1 sm:mt-0\">\n                  {user.verified ? (\n                    <span className=\"text-emerald-600 text-xs font-semibold flex items-center gap-1\">\n                      <CheckCircle className=\"w-3.5 h-3.5\" /> Verified\n                    </span>\n                  ) : (\n                    <span className=\"text-amber-600 text-xs font-semibold flex items-center gap-1\">\n                      <Clock className=\"w-3.5 h-3.5\" /> Pending\n                    </span>\n                  )}\n                </div>\n\n                <div className=\"col-span-1 sm:col-span-2 mt-1 sm:mt-0\">\n                  <div className=\"flex items-center gap-1.5\">\n                    <div className=\"w-2 h-2 rounded-full bg-emerald-500\" />\n                    <span className=\"text-xs font-medium text-slate-800\">{user.status}</span>\n                  </div>\n                </div>\n\n                <div className=\"col-span-1 sm:col-span-1 flex justify-end gap-1 mt-2 sm:mt-0\">\n                  <button\n                    onClick={() => onNavigate(\'public-student-profile\')}\n                    className=\"p-1.5 text-slate-400 hover:text-blue-600 hover:bg-slate-100 rounded-lg transition-colors\"\n                  >\n                    <Eye className=\"w-4 h-4\" />\n                  </button>\n                  <button className=\"p-1.5 text-slate-400 hover:text-blue-600 hover:bg-slate-100 rounded-lg transition-colors\">\n                    <Edit2 className=\"w-4 h-4\" />\n                  </button>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n\n        {/* Pagination */}\n        <div className=\"p-4 border-t border-slate-100 flex justify-between items-center text-xs text-slate-500\">\n          <span>Showing 1 to 3 of 14,230 users</span>\n          <div className=\"flex gap-1\">\n            <button className=\"w-8 h-8 rounded-lg border border-slate-200 flex items-center justify-center hover:bg-slate-50\">\n              <ChevronLeft className=\"w-4 h-4\" />\n            </button>\n            <button className=\"w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold\">1</button>\n            <button className=\"w-8 h-8 rounded-lg border border-slate-200 flex items-center justify-center hover:bg-slate-50\">2</button>\n            <button className=\"w-8 h-8 rounded-lg border border-slate-200 flex items-center justify-center hover:bg-slate-50\">\n              <ChevronRight className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
