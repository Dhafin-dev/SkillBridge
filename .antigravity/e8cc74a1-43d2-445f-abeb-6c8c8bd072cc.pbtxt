    replacement_chunks {
      replacement_content: "import { Project, StudentCandidate, ActiveStudentProject, ClientRequest, UserProfile } from \'../types\';\n\nexport const CURRENT_USER_STUDENT: UserProfile = {\n  id: \'u-alex\',\n  name: \'Alex Rivers\',\n  email: \'alex.rivers@university.edu\',\n  role: \'student\',\n  avatar: \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80\',\n  institution: \'Universitas Indonesia\',\n  portfolioScore: 94,\n  completedProjectsCount: 12,\n  skills: [\'React Native\', \'UI/UX Design\', \'Figma\', \'TypeScript\', \'Firebase\'],\n  bio: \'Computer Science senior passionate about accessible web apps and UI design for SMB growth.\'\n};\n\nexport const CURRENT_USER_UMKM: UserProfile = {\n  id: \'u-lumina\',\n  name: \'Lumina Beans Roastery\',\n  email: \'hello@luminabeans.com\',\n  role: \'umkm\',\n  avatar: \'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=150&auto=format&fit=crop&q=80\',\n  institution: \'Local Enterprise - Jakarta\',\n  bio: \'Female-founded roastery based in Jakarta, prioritizing ethically sourced coffee.\'\n};\n\nexport const FEATURED_PROJECT: Project = {\n  id: \'proj-featured\',\n  title: \'Revamp E-Commerce Platform\',\n  companyName: \'Lumina Beans Roastery\',\n  companyLogo: \'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=120&auto=format&fit=crop&q=80\',\n  matchScore: 98,\n  stipend: \'$350\',\n  description: \'Complete overhaul of our digital shopfront, adding subscription recurring orders and modern mobile checkout experience.\',\n  tags: [\'React\', \'Node.js\', \'UI Design\', \'Stripe\'],\n  level: \'Intermediate\',\n  duration: \'2 Months\',\n  appliedCount: 8,\n  featured: true,\n  category: \'Web Development\',\n  deadline: \'Nov 10, 2024\',\n  teamSize: \'2 Students\',\n  overview: \'Lumina Beans is scaling its direct-to-consumer coffee bean delivery. We need a team of innovative web developers and designers to build a high-converting storefront.\',\n  objectives: [\n    \'Build a seamless subscription ordering flow for coffee bean delivery.\',\n    \'Optimize page performance to achieve < 1.5s mobile load times.\',\n    \'Integrate payment gateway with auto-renewal management.\'\n  ],\n  deliverables: [\n    \'Production-ready Web App Repository (GitHub)\',\n    \'UI Design System in Figma\',\n    \'Payment & Checkout Integration Documentation\'\n  ],\n  aboutUmkm: \'Lumina Beans is a female-founded roastery based in Jakarta, prioritizing ethically sourced beans and sustainable roasting practices since 2019.\'\n};\n\nexport const PROJECTS_LIST: Project[] = [\n  {\n    id: \'proj-1\',\n    title: \'Brand Identity & Digital Strategy Revamp\',\n    companyName: \'Lumina Beans Roastery\',\n    companyLogo: \'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=120&auto=format&fit=crop&q=80\',\n    matchScore: 92,\n    stipend: \'$0\',\n    description: \'Lumina Beans is transitioning from a local wholesale roaster to a direct-to-consumer lifestyle brand. We need a team of innovative students to completely overhaul our brand identity.\',\n    tags: [\'Figma\', \'Brand Strategy\', \'Social Media\', \'Graphic Design\'],\n    level: \'Intermediate\',\n    duration: \'2 Months\',\n    appliedCount: 6,\n    category: \'UI/UX Design\',\n    deadline: \'Oct 24, 2024\',\n    teamSize: \'2-3 Students\',\n    overview: \'Lumina Beans is transitioning from a local wholesale roaster to a direct-to-consumer lifestyle brand. We need a team of innovative students to completely overhaul our brand identity, redesign our packaging concepts, and establish a foundational digital marketing strategy. This project is critical for our Q4 product launch and requires a blend of creative design and strategic business thinking.\',\n    objectives: [\n      \'Develop a cohesive, modern visual identity that appeals to Gen Z and Millennial coffee enthusiasts.\',\n      \'Create a comprehensive brand guideline document for future internal use.\',\n      \'Outline a 3-month digital launch strategy focusing on Instagram and TikTok.\'\n    ],\n    deliverables: [\n      \'Vector Logo Files (SVG, EPS)\',\n      \'Brand Guideline PDF\',\n      \'3 Packaging Mockups\',\n      \'Digital Strategy Deck\'\n    ],\n    aboutUmkm: \'Lumina Beans is a female-founded roastery based in Jakarta, prioritizing ethically sourced beans and sustainable roasting practices since 2019.\'\n  },\n  {\n    id: \'proj-2\',\n    title: \'Mobile App for Organic Delivery\',\n    companyName: \'FRESHBITES ORGANIC\',\n    companyLogo: \'https://images.unsplash.com/photo-1542838132-92c53300491e?w=120&auto=format&fit=crop&q=80\',\n    matchScore: 95,\n    stipend: \'$0\',\n    description: \'We need a skilled developer to build a cross-platform mobile application for our organic grocery delivery service. Must include user auth and real-time order status.\',\n    tags: [\'React Native\', \'Firebase\', \'UI Design\'],\n    level: \'Intermediate\',\n    duration: \'3 Months\',\n    appliedCount: 4,\n    category: \'Mobile App\',\n    deadline: \'Nov 15, 2024\',\n    teamSize: \'2 Students\',\n    overview: \'FreshBites Organic connects local eco-farms with city households. We want to empower urban shoppers with a crisp mobile application to browse weekly fresh produce baskets.\',\n    objectives: [\n      \'Implement real-time basket customization and inventory count.\',\n      \'Build localized push notification triggers for active deliveries.\',\n      \'Craft a vibrant, accessible green color theme user interface.\'\n    ],\n    deliverables: [\n      \'iOS & Android Cross-Platform App Codebase\',\n      \'Firebase Backend Auth & Firestore Rules\',\n      \'User Onboarding Guide\'\n    ],\n    aboutUmkm: \'FreshBites Organic is a certified organic farm co-op promoting local agriculture and plastic-free packaging.\'\n  },\n  {\n    id: \'proj-3\',\n    title: \'Instagram & TikTok Content Revamp\',\n    companyName: \'BEANCRAFT ROASTERS\',\n    companyLogo: \'https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?w=120&auto=format&fit=crop&q=80\',\n    matchScore: 82,\n    stipend: \'$0\',\n    description: \'Looking for a creative marketing student to revamp our Instagram presence, create a content calendar, and design templates for our upcoming coffee releases.\',\n    tags: [\'Marketing\', \'Figma\', \'Copywriting\'],\n    level: \'Beginner\',\n    duration: \'1 Month\',\n    appliedCount: 12,\n    category: \'Marketing\',\n    deadline: \'Oct 30, 2024\',\n    teamSize: \'1-2 Students\',\n    overview: \'BeanCraft Roasters seeks a fresh digital voice to connect with young coffee lovers across social platforms.\',\n    objectives: [\n      \'Produce 15 high-engagement short videos and aesthetic carousel posts.\',\n      \'Define hashtag clusters and target engagement hours.\',\n      \'Set up a reusable social media design kit in Canva/Figma.\'\n    ],\n    deliverables: [\n      \'30-Day Content Calendar Grid\',\n      \'15 Canva / Figma Story & Feed Templates\',\n      \'Audience Engagement Playbook\'\n    ],\n    aboutUmkm: \'BeanCraft Roasters is a specialty micro-roaster located in Bandung known for artisanal cold brews.\'\n  },\n  {\n    id: \'proj-4\',\n    title: \'Financial Data Analysis & Forecast\',\n    companyName: \'LocalRoast Coffee\',\n    companyLogo: \'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=120&auto=format&fit=crop&q=80\',\n    matchScore: 88,\n    stipend: \'$200\',\n    description: \'Analyze 12 months of sales transactions to identify peak revenue windows, top-selling blend margins, and quarterly expenditure forecasts.\',\n    tags: [\'Data Science\', \'Python\', \'Analytics\', \'Excel\'],\n    level: \'Intermediate\',\n    duration: \'1 Month\',\n    appliedCount: 5,\n    category: \'Data Science\',\n    deadline: \'Oct 22, 2024\',\n    teamSize: \'1 Student\',\n    overview: \'LocalRoast Coffee needs data-driven guidance on inventory spending and menu pricing for 2025.\',\n    objectives: [\n      \'Clean transaction data across 3 cafe locations.\',\n      \'Build interactive dashboard charts showing month-over-month growth.\',\n      \'Formulate pricing recommendation models.\'\n    ],\n    deliverables: [\n      \'Interactive Streamlit / Excel Dashboard\',\n      \'Executive Financial Summary Report (PDF)\',\n      \'Raw Cleaned Datasets\'\n    ],\n    aboutUmkm: \'LocalRoast Coffee operates 3 neighborhood cafes dedicated to fair-trade single-origin espresso.\'\n  }\n];\n\nexport const RECOMMENDED_STUDENTS: StudentCandidate[] = [\n  {\n    id: \'stud-1\',\n    name: \'Budi Santoso\',\n    avatar: \'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&auto=format&fit=crop&q=80\',\n    institution: \'Universitas Indonesia\',\n    matchScore: 98,\n    portfolioScore: 94,\n    projectsCompleted: 8,\n    skills: [\'SEO\', \'Content Strategy\', \'Analytics\'],\n    bio: \'Digital marketing strategist who generated +140% organic traffic growth for 3 regional e-commerce stores.\'\n  },\n  {\n    id: \'stud-2\',\n    name: \'Siti Aminah\',\n    avatar: \'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=150&auto=format&fit=crop&q=80\',\n    institution: \'Institut Teknologi Bandung\',\n    matchScore: 92,\n    portfolioScore: 88,\n    projectsCompleted: 5,\n    skills: [\'Social Media\', \'Copywriting\', \'Analytics\'],\n    bio: \'Creative storyteller and copywriter specializing in brand voice building for sustainable startups.\'\n  },\n  {\n    id: \'stud-3\',\n    name: \'Rian Pratama\',\n    avatar: \'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=150&auto=format&fit=crop&q=80\',\n    institution: \'Universitas Gadjah Mada\',\n    matchScore: 89,\n    portfolioScore: 91,\n    projectsCompleted: 6,\n    skills: [\'React\', \'TypeScript\', \'Node.js\'],\n    bio: \'Full-stack software engineering student dedicated to building fast web platforms for small businesses.\'\n  },\n  {\n    id: \'stud-4\',\n    name: \'Dewi Lestari\',\n    avatar: \'https://images.unsplash.com/photo-1580489944761-15a19d654956?w=150&auto=format&fit=crop&q=80\',\n    institution: \'Universitas Airlangga\',\n    matchScore: 85,\n    portfolioScore: 86,\n    projectsCompleted: 4,\n    skills: [\'Figma\', \'UI/UX Design\', \'User Research\'],\n    bio: \'Product designer focusing on user-centered design systems and smooth mobile interfaces.\'\n  }\n];\n\nexport const STUDENT_ACTIVE_PROJECTS: ActiveStudentProject[] = [\n  {\n    id: \'act-1\',\n    title: \'E-Commerce App Redesign\',\n    companyName: \'Urban Threads UMKM\',\n    companyLogo: \'https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=120&auto=format&fit=crop&q=80\',\n    status: \'In Progress\',\n    phaseName: \'Phase 2: UI Design\',\n    dueDate: \'Due Oct 15\',\n    progressPercent: 65,\n    category: \'UI/UX Design\'\n  },\n  {\n    id: \'act-2\',\n    title: \'Marketing Campaign Strategy\',\n    companyName: \'Bloom Floral Studio\',\n    companyLogo: \'https://images.unsplash.com/photo-1563245372-f21724e3856d?w=120&auto=format&fit=crop&q=80\',\n    status: \'Urgent\',\n    phaseName: \'Phase 3: Content Creation\',\n    dueDate: \'Due Tomorrow\',\n    dueAlert: true,\n    progressPercent: 85,\n    category: \'Marketing\'\n  },\n  {\n    id: \'act-3\',\n    title: \'Financial Data Analysis\',\n    companyName: \'LocalRoast Coffee\',\n    companyLogo: \'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=120&auto=format&fit=crop&q=80\',\n    status: \'In Progress\',\n    phaseName: \'Phase 1: Data Gathering\',\n    dueDate: \'Due Oct 22\',\n    progressPercent: 25,\n    category: \'Data Science\'\n  }\n];\n\nexport const CLIENT_REQUESTS_LIST: ClientRequest[] = [\n  {\n    id: \'req-1\',\n    title: \'Social Media Revamp\',\n    status: \'Active\',\n    assignedStudent: \'Sarah Chen\',\n    assignedStudentAvatar: \'https://images.unsplash.com/photo-1517841905240-47